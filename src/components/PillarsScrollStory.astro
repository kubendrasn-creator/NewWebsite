---
// src/components/PillarsScrollStory.astro
// Clean, fast, unpinned 3-card bento grid for Apt, Agile, and Assured.
// Zero scroll-trapping, zero pinning bugs. Content is immediately visible and accessible.
import { siteContent } from '../content/site';
import PillarApt from './illustrations/PillarApt.astro';
import PillarAgile from './illustrations/PillarAgile.astro';
import PillarAssured from './illustrations/PillarAssured.astro';

const pillars = siteContent.pillars;
---

<section id="pillars" class="py-20 sm:py-28 bg-[#eef7fd]/50 border-b border-[#d4e8f7] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header: Centered & Compact (Never pushes content offscreen) -->
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7] shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#0088cc]"></span>
        <span>Strategic Foundation</span>
      </span>
      <h2
        class="text-3xl sm:text-5xl font-black text-[#003074] tracking-tight outline-none"
      >
        Apt <span class="text-[#0070a8]">•</span> Agile <span class="text-[#0070a8]">•</span> Assured
      </h2>
      <p class="text-base sm:text-lg text-[#003074]/80 max-w-2xl mx-auto leading-relaxed">
        Every initiative begins with precision alignment, adapts through flexible engagement, and concludes with uncompromising engineering assurance.
      </p>
    </div>

    <!-- 3-Column Pillar Bento Grid: Immediate visibility, 0 scroll lag, 0 stuck states -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      
      <!-- 01: Apt -->
      <div class="bento-conic-border p-8 rounded-3xl bg-white border border-[#d4e8f7] shadow-lg shadow-blue-900/5 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 hover:shadow-xl">
        <div class="space-y-6">
          <!-- Illustration Container -->
          <div class="aspect-[16/10] rounded-2xl bg-[#eef7fd] border border-[#d4e8f7] flex items-center justify-center p-6 overflow-hidden">
            <div class="w-full h-full max-h-[180px] flex items-center justify-center">
              <PillarApt />
            </div>
          </div>

          <!-- Eyebrow & Numeral -->
          <div class="flex items-center justify-between">
            <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
              {pillars[0].eyebrow}
            </span>
            <span class="w-2 h-2 rounded-full bg-[#0088cc]"></span>
          </div>

          <!-- Title -->
          <h3 class="text-2xl sm:text-3xl font-black text-[#003074]">
            {pillars[0].name}
          </h3>

          <!-- Description (Verbatim from CONTENT.md) -->
          <p class="text-sm sm:text-base text-[#003074]/85 leading-relaxed font-normal">
            {pillars[0].description}
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Tailored Architecture</span>
          <span class="font-mono">01 / 03</span>
        </div>
      </div>

      <!-- 02: Agile -->
      <div class="bento-conic-border p-8 rounded-3xl bg-white border border-[#d4e8f7] shadow-lg shadow-blue-900/5 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 hover:shadow-xl">
        <div class="space-y-6">
          <!-- Illustration Container -->
          <div class="aspect-[16/10] rounded-2xl bg-[#eef7fd] border border-[#d4e8f7] flex items-center justify-center p-6 overflow-hidden">
            <div class="w-full h-full max-h-[180px] flex items-center justify-center">
              <PillarAgile />
            </div>
          </div>

          <!-- Eyebrow & Numeral -->
          <div class="flex items-center justify-between">
            <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
              {pillars[1].eyebrow}
            </span>
            <span class="w-2 h-2 rounded-full bg-[#0088cc]"></span>
          </div>

          <!-- Title -->
          <h3 class="text-2xl sm:text-3xl font-black text-[#003074]">
            {pillars[1].name}
          </h3>

          <!-- Description (Verbatim from CONTENT.md) -->
          <p class="text-sm sm:text-base text-[#003074]/85 leading-relaxed font-normal">
            {pillars[1].description}
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Rapid Evolution</span>
          <span class="font-mono">02 / 03</span>
        </div>
      </div>

      <!-- 03: Assured -->
      <div class="bento-conic-border p-8 rounded-3xl bg-white border border-[#d4e8f7] shadow-lg shadow-blue-900/5 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 hover:shadow-xl">
        <div class="space-y-6">
          <!-- Illustration Container -->
          <div class="aspect-[16/10] rounded-2xl bg-[#eef7fd] border border-[#d4e8f7] flex items-center justify-center p-6 overflow-hidden">
            <div class="w-full h-full max-h-[180px] flex items-center justify-center">
              <PillarAssured />
            </div>
          </div>

          <!-- Eyebrow & Numeral -->
          <div class="flex items-center justify-between">
            <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
              {pillars[2].eyebrow}
            </span>
            <span class="w-2 h-2 rounded-full bg-[#0088cc]"></span>
          </div>

          <!-- Title -->
          <h3 class="text-2xl sm:text-3xl font-black text-[#003074]">
            {pillars[2].name}
          </h3>

          <!-- Description (Verbatim from CONTENT.md) -->
          <p class="text-sm sm:text-base text-[#003074]/85 leading-relaxed font-normal">
            {pillars[2].description}
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Reliable Execution</span>
          <span class="font-mono">03 / 03</span>
        </div>
      </div>

    </div>

  </div>
</section>
