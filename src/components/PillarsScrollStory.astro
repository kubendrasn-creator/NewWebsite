---
// PillarsScrollStory.astro
// Pinned scroll story with GSAP ScrollTrigger, replacing placeholder raster images
// with bespoke SVG scene illustrations (PillarApt, PillarAgile, PillarAssured),
// morphing headline word, vertical progress rail, and 3 parallax layers.
import { siteContent } from '../content/site';
import PillarApt from './illustrations/PillarApt.astro';
import PillarAgile from './illustrations/PillarAgile.astro';
import PillarAssured from './illustrations/PillarAssured.astro';

const pillars = siteContent.pillars;
---

<section id="pillars" class="relative py-24 sm:py-32 bg-[#eef7fd] border-b border-[#d4e8f7]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Focus Target for clean hash-less navigation -->
    <div class="max-w-3xl mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider mb-4 border border-[#d4e8f7] shadow-sm">
        <span>Strategic Foundation</span>
      </span>
      <h2
        tabindex="-1"
        class="section-title text-[#003074] outline-none"
      >
        Apt <span class="text-[#0088cc]">•</span> Agile <span class="text-[#0088cc]">•</span> Assured
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#003074]/80 max-w-2xl">
        Every initiative begins with precision alignment, adapts through flexible engagement, and concludes with uncompromising engineering assurance.
      </p>
    </div>

    <!-- Pinned Scroll Story Layout (12-column asymmetric grid) -->
    <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left: Vertical Progress Rail + Steps (6 cols) -->
      <div class="lg:col-span-6 relative flex gap-6 sm:gap-8">
        
        <!-- Animated Progress Rail Indicator -->
        <div class="relative w-1.5 bg-[#d4e8f7] rounded-full shrink-0 my-4 hidden sm:block">
          <div
            id="pillars-rail-indicator"
            class="absolute top-0 left-0 w-full bg-[#0088cc] rounded-full origin-top scale-y-0 h-full transition-transform duration-100"
          />
        </div>

        <!-- Pillar Narrative Cards -->
        <div class="space-y-8 sm:space-y-12 w-full">
          {pillars.map((pillar, idx) => (
            <div
              class={`pillar-step-card p-8 rounded-2xl bg-white border border-[#d4e8f7] shadow-sm transition-all duration-300 ${
                idx === 0 ? 'ring-2 ring-[#0070a8]/20 shadow-md' : ''
              }`}
            >
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
                  {pillar.eyebrow}
                </span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#0088cc]" />
              </div>
              <h3 class="text-2xl sm:text-3xl font-black text-[#003074] mb-4">
                {pillar.name}
              </h3>
              <p class="text-sm sm:text-base text-[#003074]/90 leading-relaxed font-normal">
                {pillar.description}
              </p>
            </div>
          ))}
        </div>

      </div>

      <!-- Right: Pinned Bespoke SVG Illustration Stage (6 cols) -->
      <div class="lg:col-span-6 relative aspect-square sm:aspect-[4/3] rounded-3xl overflow-hidden bg-white shadow-xl border-2 border-[#d4e8f7] flex items-center justify-center p-6 sm:p-10 sticky top-24">
        
        <!-- Pillar 1 Scene: Apt (Interlocking Shapes & Swoosh) -->
        <div class="pillar-scene absolute inset-0 w-full h-full p-6 sm:p-10 flex flex-col items-center justify-center transition-opacity duration-300">
          <div class="w-full h-full max-h-[320px] flex items-center justify-center">
            <PillarApt />
          </div>
          <div class="mt-4 px-4 py-2 rounded-xl bg-[#eef7fd] border border-[#d4e8f7] flex items-center justify-between w-full max-w-sm">
            <span class="text-xs font-black uppercase tracking-wider text-[#003074]">
              Pillar 01 — Appropriate &amp; Relevant
            </span>
            <span class="text-xs font-mono font-bold text-[#0070a8]">01 / 03</span>
          </div>
        </div>

        <!-- Pillar 2 Scene: Agile (Dynamic Re-routing Flow) -->
        <div class="pillar-scene absolute inset-0 w-full h-full p-6 sm:p-10 flex flex-col items-center justify-center opacity-0 transition-opacity duration-300">
          <div class="w-full h-full max-h-[320px] flex items-center justify-center">
            <PillarAgile />
          </div>
          <div class="mt-4 px-4 py-2 rounded-xl bg-[#eef7fd] border border-[#d4e8f7] flex items-center justify-between w-full max-w-sm">
            <span class="text-xs font-black uppercase tracking-wider text-[#003074]">
              Pillar 02 — Flexible &amp; Adaptive
            </span>
            <span class="text-xs font-mono font-bold text-[#0070a8]">02 / 03</span>
          </div>
        </div>

        <!-- Pillar 3 Scene: Assured (Concentric Rings & Shield Stamp) -->
        <div class="pillar-scene absolute inset-0 w-full h-full p-6 sm:p-10 flex flex-col items-center justify-center opacity-0 transition-opacity duration-300">
          <div class="w-full h-full max-h-[320px] flex items-center justify-center">
            <PillarAssured />
          </div>
          <div class="mt-4 px-4 py-2 rounded-xl bg-[#eef7fd] border border-[#d4e8f7] flex items-center justify-between w-full max-w-sm">
            <span class="text-xs font-black uppercase tracking-wider text-[#003074]">
              Pillar 03 — Uncompromising Quality
            </span>
            <span class="text-xs font-mono font-bold text-[#0070a8]">03 / 03</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
