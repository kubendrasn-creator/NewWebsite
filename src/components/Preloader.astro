---
// Preloader.astro
// Max 900ms stroke-draw preloader using the logo 'i' swoosh motif.
// Runs only once per session via sessionStorage. Skippable on click / keypress.
---

<aside
  id="preloader-overlay"
  class="fixed inset-0 z-[10000] flex flex-col items-center justify-center bg-white transition-opacity duration-300 pointer-events-auto"
  aria-label="Loading Apt Infosoft"
>
  <div class="relative flex flex-col items-center gap-6">
    <!-- SVG Stroke Draw Motif (The slanted 'i' with swoosh flick from the logo) -->
    <svg
      class="w-20 h-20 text-[#0088cc]"
      viewBox="0 0 100 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Slanted stem -->
      <path
        id="preloader-stem"
        d="M 45 42 L 53 84"
        stroke="#003074"
        stroke-width="12"
        stroke-linecap="round"
        class="preloader-stroke"
      />
      <!-- Dynamic swoosh dot / flick -->
      <path
        id="preloader-swoosh"
        d="M 32 24 C 42 16, 68 18, 76 28 C 72 32, 58 36, 48 30 Z"
        fill="#0088cc"
        stroke="#0088cc"
        stroke-width="2"
        class="preloader-swoosh"
      />
    </svg>

    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0088cc] animate-ping" />
      <span class="text-xs font-black tracking-widest text-[#003074] uppercase">
        Apt Infosoft
      </span>
    </div>
  </div>

  <button
    id="skip-preloader-btn"
    type="button"
    class="absolute bottom-8 text-xs font-semibold text-[#0070a8] hover:underline focus:outline-none cursor-pointer"
  >
    Skip Intro [Esc]
  </button>
</aside>

<style>
  .preloader-stroke {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: strokeDraw 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .preloader-swoosh {
    opacity: 0;
    transform: scale(0.6) rotate(-8deg);
    transform-origin: center;
    animation: popSwoosh 0.4s 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes strokeDraw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes popSwoosh {
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
</style>

<script>
  function dismissPreloader() {
    const el = document.getElementById('preloader-overlay');
    if (!el) return;
    el.style.opacity = '0';
    el.style.pointerEvents = 'none';
    setTimeout(() => {
      el.remove();
    }, 320);
    try {
      sessionStorage.setItem('apt_intro_seen', 'true');
    } catch (e) {}
  }

  try {
    if (sessionStorage.getItem('apt_intro_seen') === 'true') {
      const el = document.getElementById('preloader-overlay');
      if (el) el.remove();
    } else {
      // Auto dismiss after maximum 900ms
      const timer = setTimeout(dismissPreloader, 850);

      const skipBtn = document.getElementById('skip-preloader-btn');
      skipBtn?.addEventListener('click', () => {
        clearTimeout(timer);
        dismissPreloader();
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' || e.key === 'Enter') {
          clearTimeout(timer);
          dismissPreloader();
        }
      });
    }
  } catch (e) {
    dismissPreloader();
  }
</script>
