---
// WhyAptSection.astro
// Horizontal pinned scroll through three panels (Flexibility, Reliability and Scalability, Efficiency)
// Degrades cleanly to vertical stack on mobile.
import { siteContent } from '../content/site';
import Tabs from './islands/Tabs';

const whyList = siteContent.whyApt;
---

<section id="why-apt" class="py-24 sm:py-32 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#eef7fd] text-[#0070a8] text-xs font-bold uppercase tracking-wider mb-4 border border-[#d4e8f7]">
        <span>Model Advantage</span>
      </span>
      <h2
        tabindex="-1"
        class="text-3xl sm:text-5xl font-black text-[#003074] tracking-tight outline-none"
      >
        Why Apt Infosoft
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#003074]/80">
        Flexibility in engagement, proven reliability at scale, and cost-efficient delivery across time zones.
      </p>
    </div>
  </div>

  <!-- Horizontal Scroll Track for Desktop / Vertical Stack on Mobile -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      id="why-apt-horizontal-track"
      class="flex flex-col lg:flex-row gap-8 lg:gap-10 w-full"
    >
      {whyList.map((item, idx) => (
        <div
          class="w-full lg:w-[620px] shrink-0 p-8 sm:p-12 rounded-3xl bg-[#f5fafe] border-2 border-[#d4e8f7] shadow-sm flex flex-col justify-between space-y-6"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
                Advantage 0{idx + 1}
              </span>
              <span class="text-xs font-mono font-bold text-[#0070a8]">
                {item.id}
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-black text-[#003074] mb-4">
              {item.title}
            </h3>

            <p class="text-sm sm:text-base text-[#003074]/85 leading-relaxed font-normal mb-6">
              {item.shortDescription}
            </p>

            {/* If this is the Flexibility panel, render the Tabs Island */}
            {item.id === 'flexibility' && item.models && (
              <div class="mt-6 pt-6 border-t border-[#d4e8f7]">
                <Tabs client:visible models={item.models} />
              </div>
            )}

            {/* If not flexibility, show the full verified description */}
            {item.id !== 'flexibility' && (
              <p class="text-sm text-[#003074]/75 leading-relaxed border-t border-[#d4e8f7] pt-4">
                {item.fullDescription}
              </p>
            )}
          </div>

          <div class="pt-4 flex items-center justify-between text-xs font-bold text-[#0070a8]">
            <span class="uppercase tracking-wider">Apt Infosoft Assurance</span>
            <span>✓ Verified Model</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
