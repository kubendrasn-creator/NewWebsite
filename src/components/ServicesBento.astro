---
// src/components/ServicesBento.astro
// Services Bento Grid: Application Modernization (04) is 2x2, Application Development (02) is 2x1 wide
// with its 3 verbatim platform items as plain text, others standard 1x1. Original numerals 01-06 preserved.
import { siteContent } from '../content/site';
import { url } from '../utils/url';

const services = siteContent.services;
const mod = services.find((s) => s.slug === 'application-modernization')!;
const appDev = services.find((s) => s.slug === 'application-development')!;
const prodEng = services.find((s) => s.slug === 'product-engineering')!;
const saas = services.find((s) => s.slug === 'saas')!;
const testing = services.find((s) => s.slug === 'testing')!;
const analytics = services.find((s) => s.slug === 'business-analytics')!;
---

<section
  id="services-bento"
  class="py-20 sm:py-28 bg-[#eef7fd]/40 border-b border-[#d4e8f7]"
  aria-labelledby="services-bento-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl space-y-3">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7]">
          <span>Services</span>
        </span>
        <h2 id="services-bento-heading" class="text-3xl sm:text-4xl font-black text-[#003074] tracking-tight">
          Software Engineering Services
        </h2>
      </div>

      <a
        href={url('/services')}
        data-astro-prefetch="hover"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold text-white bg-[#0070a8] hover:bg-[#003074] transition-colors shadow-sm shrink-0"
      >
        <span>Our Services</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Bento Grid: 4 columns from 1024px (lg) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 auto-rows-fr">
      <!-- 04: Application Modernization (Large 2x2) -->
      <a
        href={url(`/services/${mod.slug}`)}
        data-astro-prefetch="hover"
        data-service-numeral={mod.number}
        class="bento-tile-modernization lg:col-span-2 lg:row-span-2 group p-8 rounded-3xl bg-white border border-[#d4e8f7] hover:border-[#0088cc] shadow-sm hover:shadow-lg transition-all flex flex-col justify-between"
      >
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-black text-[#0088cc]">{mod.number}</span>
            <span class="px-2.5 py-1 rounded-full bg-[#eef7fd] border border-[#d4e8f7] text-[11px] font-bold uppercase tracking-wider text-[#0070a8]">
              {mod.shortTitle}
            </span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
            {mod.title}
          </h3>
          <p class="text-sm sm:text-base text-[#003074]/85 leading-relaxed">
            {mod.summary}
          </p>
          <p class="text-sm text-[#003074]/80 leading-relaxed">
            {mod.fullDescription}
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-[#eef7fd] flex items-center justify-between text-sm font-bold text-[#0070a8] group-hover:text-[#003074]">
          <span>Explore</span>
          <span aria-hidden="true">→</span>
        </div>
      </a>

      <!-- 01: Product Engineering (1x1) -->
      <a
        href={url(`/services/${prodEng.slug}`)}
        data-astro-prefetch="hover"
        data-service-numeral={prodEng.number}
        class="bento-tile-standard group p-6 rounded-3xl bg-white border border-[#d4e8f7] hover:border-[#0088cc] shadow-sm hover:shadow-lg transition-all flex flex-col justify-between"
      >
        <div class="space-y-3">
          <span class="text-xs font-mono font-black text-[#0088cc]">{prodEng.number}</span>
          <h3 class="text-lg font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
            {prodEng.title}
          </h3>
          <p class="text-xs sm:text-sm text-[#003074]/80 leading-relaxed line-clamp-3">
            {prodEng.summary}
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Explore</span>
          <span aria-hidden="true">→</span>
        </div>
      </a>

      <!-- 03: Cloud SaaS (1x1) -->
      <a
        href={url(`/services/${saas.slug}`)}
        data-astro-prefetch="hover"
        data-service-numeral={saas.number}
        class="bento-tile-standard group p-6 rounded-3xl bg-white border border-[#d4e8f7] hover:border-[#0088cc] shadow-sm hover:shadow-lg transition-all flex flex-col justify-between"
      >
        <div class="space-y-3">
          <span class="text-xs font-mono font-black text-[#0088cc]">{saas.number}</span>
          <h3 class="text-lg font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
            {saas.title}
          </h3>
          <p class="text-xs sm:text-sm text-[#003074]/80 leading-relaxed line-clamp-3">
            {saas.summary}
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Explore</span>
          <span aria-hidden="true">→</span>
        </div>
      </a>

      <!-- 02: Custom Application Development (Wide 2x1 with 3 verbatim platform items as plain text) -->
      <a
        href={url(`/services/${appDev.slug}`)}
        data-astro-prefetch="hover"
        data-service-numeral={appDev.number}
        class="bento-tile-appdev md:col-span-2 lg:col-span-2 group p-7 rounded-3xl bg-white border border-[#d4e8f7] hover:border-[#0088cc] shadow-sm hover:shadow-lg transition-all flex flex-col justify-between"
      >
        <div class="space-y-3">
          <span class="text-xs font-mono font-black text-[#0088cc]">{appDev.number}</span>
          <h3 class="text-xl font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
            {appDev.title}
          </h3>
          <p class="text-sm text-[#003074]/85 leading-relaxed">
            {appDev.summary}
          </p>
          {appDev.bulletPoints && (
            <p class="text-xs font-bold text-[#0070a8] pt-1">
              {appDev.bulletPoints.join(' • ')}
            </p>
          )}
        </div>
        <div class="pt-4 mt-4 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Explore</span>
          <span aria-hidden="true">→</span>
        </div>
      </a>

      <!-- 05: Testing Services (1x1) -->
      <a
        href={url(`/services/${testing.slug}`)}
        data-astro-prefetch="hover"
        data-service-numeral={testing.number}
        class="bento-tile-standard md:col-span-1 lg:col-span-2 group p-6 rounded-3xl bg-white border border-[#d4e8f7] hover:border-[#0088cc] shadow-sm hover:shadow-lg transition-all flex flex-col justify-between"
      >
        <div class="space-y-3">
          <span class="text-xs font-mono font-black text-[#0088cc]">{testing.number}</span>
          <h3 class="text-lg font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
            {testing.title}
          </h3>
          <p class="text-xs sm:text-sm text-[#003074]/80 leading-relaxed line-clamp-3">
            {testing.summary}
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Explore</span>
          <span aria-hidden="true">→</span>
        </div>
      </a>

      <!-- 06: Business Reporting and Analytics (1x1) -->
      <a
        href={url(`/services/${analytics.slug}`)}
        data-astro-prefetch="hover"
        data-service-numeral={analytics.number}
        class="bento-tile-standard md:col-span-1 lg:col-span-2 group p-6 rounded-3xl bg-white border border-[#d4e8f7] hover:border-[#0088cc] shadow-sm hover:shadow-lg transition-all flex flex-col justify-between"
      >
        <div class="space-y-3">
          <span class="text-xs font-mono font-black text-[#0088cc]">{analytics.number}</span>
          <h3 class="text-lg font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
            {analytics.title}
          </h3>
          <p class="text-xs sm:text-sm text-[#003074]/80 leading-relaxed line-clamp-3">
            {analytics.summary}
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-[#eef7fd] flex items-center justify-between text-xs font-bold text-[#0070a8]">
          <span>Explore</span>
          <span aria-hidden="true">→</span>
        </div>
      </a>
    </div>
  </div>
</section>
