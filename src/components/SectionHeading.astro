---
// SectionHeading.astro
interface Props {
  tag?: 'h1' | 'h2' | 'h3';
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
  id?: string;
}

const {
  tag: Tag = 'h2',
  eyebrow,
  title,
  subtitle,
  align = 'center',
  class: className = '',
  id,
} = Astro.props;
---

<div class={`space-y-3 ${align === 'center' ? 'text-center mx-auto' : 'text-left'} max-w-3xl ${className}`}>
  {eyebrow && (
    <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
      {eyebrow}
    </p>
  )}
  <Tag id={id} class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-navy-900 dark:text-white leading-[1.15]">
    {title}
  </Tag>
  {subtitle && (
    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed pt-1">
      {subtitle}
    </p>
  )}
</div>
