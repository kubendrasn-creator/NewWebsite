---
// ValueCard.astro
interface Props {
  pillar: string;
  title: string;
  description: string;
  highlights: string[];
}

const { pillar, title, description, highlights } = Astro.props;

// Pillar-specific accent badges
const badgeColors: Record<string, { bg: string; text: string; border: string; glow: string }> = {
  Apt: {
    bg: 'bg-blue-50 dark:bg-blue-950/70',
    text: 'text-[#0073df] dark:text-[#38bdf8]',
    border: 'border-blue-200 dark:border-blue-800/60',
    glow: 'group-hover:border-[#0073df]/50',
  },
  Agile: {
    bg: 'bg-cyan-50 dark:bg-cyan-950/70',
    text: 'text-[#0096c7] dark:text-[#00b4d8]',
    border: 'border-cyan-200 dark:border-cyan-800/60',
    glow: 'group-hover:border-[#00b4d8]/50',
  },
  Assured: {
    bg: 'bg-indigo-50 dark:bg-indigo-950/70',
    text: 'text-[#4f46e5] dark:text-[#818cf8]',
    border: 'border-indigo-200 dark:border-indigo-800/60',
    glow: 'group-hover:border-[#6366f1]/50',
  },
};

const colors = badgeColors[pillar] || badgeColors.Apt;
---

<div class={`group relative flex flex-col justify-between p-8 sm:p-10 rounded-3xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:shadow-2xl transition-all duration-300 ${colors.glow} hover:-translate-y-1`}>
  <div>
    <!-- Pillar Badge -->
    <div class="flex items-center justify-between mb-6">
      <div class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider ${colors.bg} ${colors.text} border ${colors.border}`}>
        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
        <span>{pillar}</span>
      </div>
      <span class="text-xs font-mono text-slate-400">Core Pillar</span>
    </div>

    <!-- Title -->
    <h3 class="text-2xl font-bold text-navy-900 dark:text-white mb-4 group-hover:text-[#0073df] dark:group-hover:text-[#38bdf8] transition-colors">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6 font-normal">
      {description}
    </p>

    <!-- Highlights List -->
    <ul class="space-y-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
      {highlights.map((item) => (
        <li class="flex items-start gap-2.5">
          <svg class={`w-4 h-4 mt-0.5 shrink-0 ${colors.text}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span class="leading-snug">{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-8 pt-6 border-t border-[var(--color-border)] flex items-center justify-between text-xs text-slate-600 dark:text-slate-400 font-medium">
    <span>Apt Infosoft Standard</span>
    <svg class="w-4 h-4 text-slate-400 group-hover:translate-x-1 group-hover:text-[#0073df] transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </div>
</div>
