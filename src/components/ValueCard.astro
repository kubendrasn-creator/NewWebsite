---
// ValueCard.astro
interface Props {
  pillar: string;
  title: string;
  description: string;
  highlights: string[];
}

const { pillar, title, description, highlights } = Astro.props;
---

<div class="relative flex flex-col justify-between p-8 sm:p-10 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-teal-500/40 hover:shadow-lg transition-all duration-300">
  <div>
    <!-- Pillar Tag -->
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800/40 mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
      {pillar}
    </div>

    <!-- Title -->
    <h3 class="text-2xl font-bold text-navy-900 dark:text-white mb-4">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6">
      {description}
    </p>

    <!-- Highlights List -->
    <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
      {highlights.map((item) => (
        <li class="flex items-start gap-2">
          <svg class="w-4 h-4 mt-0.5 text-teal-600 dark:text-teal-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-8 pt-6 border-t border-[var(--color-border)] text-xs text-slate-400 dark:text-slate-500">
    Brand Pillar • Apt Infosoft Principle
  </div>
</div>
