---
// AboutSection.astro
// Scroll-linked text-fill reveal for the two paragraphs and 4 selectable cards with smooth expand trick
import { siteContent } from '../content/site';

const { about } = siteContent;
const p1Words = about.paragraphs[0].split(' ');
const p2Words = about.paragraphs[1].split(' ');
---

<section id="about" class="py-24 sm:py-32 bg-[#eef7fd] border-y border-[#d4e8f7] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Eyebrow & Title -->
    <div class="max-w-3xl mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider mb-4 border border-[#d4e8f7] shadow-sm">
        <span>{about.eyebrow}</span>
      </span>
      <h2 class="text-3xl sm:text-5xl font-black text-[#003074] tracking-tight">
        {about.title}
      </h2>
    </div>

    <!-- Scroll-Linked Text-Fill Reveal Narrative Container -->
    <div id="about-narrative" class="max-w-4xl p-8 sm:p-14 rounded-3xl bg-white border border-[#d4e8f7] shadow-md mb-20 space-y-8">
      
      <!-- Paragraph 1 with Word-by-Word Scroll Reveal -->
      <p class="text-lg sm:text-2xl font-semibold leading-relaxed text-[#003074]">
        {p1Words.map((word) => (
          <span class="about-reveal-word inline-block mr-1.5 transition-opacity duration-150">
            {word}
          </span>
        ))}
      </p>

      <!-- Paragraph 2 with Word-by-Word Scroll Reveal -->
      <p class="text-base sm:text-xl font-normal leading-relaxed text-[#003074]/90 border-t border-[#d4e8f7] pt-8">
        {p2Words.map((word) => (
          <span class="about-reveal-word inline-block mr-1.5 transition-opacity duration-150">
            {word}
          </span>
        ))}
      </p>

    </div>

    <!-- "Who Can Benefit From Our Engagement?" 4 Selectable Cards -->
    <div class="space-y-8">
      <div class="max-w-3xl">
        <h3 class="text-2xl sm:text-3xl font-black text-[#003074]">
          {about.audienceHeading}
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {about.audienceItems.map((item) => (
          <details class="group p-6 sm:p-8 rounded-2xl bg-white border border-[#d4e8f7] shadow-sm transition-all duration-200 hover:border-[#0088cc] hover:shadow-md cursor-pointer">
            <summary class="flex items-center justify-between list-none font-bold text-[#003074] text-lg sm:text-xl focus:outline-none">
              <div class="flex items-center gap-4">
                <span class="w-9 h-9 rounded-xl bg-[#eef7fd] text-[#0070a8] flex items-center justify-center font-black text-sm border border-[#d4e8f7] group-open:bg-[#0070a8] group-open:text-white transition-colors">
                  {item.letter}
                </span>
                <span>{item.title}</span>
              </div>
              <span class="text-[#0088cc] text-xl transform group-open:rotate-180 transition-transform duration-200">
                ↓
              </span>
            </summary>
            
            <!-- Smooth expand trick using CSS grid rows or interpolate-size -->
            <div class="mt-4 pt-4 border-t border-[#d4e8f7] text-sm sm:text-base text-[#003074]/85 leading-relaxed font-normal">
              <p>{item.description}</p>
            </div>
          </details>
        ))}
      </div>
    </div>

  </div>
</section>
