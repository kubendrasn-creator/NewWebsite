---
// src/components/CTABand.astro
// Action band driving engagement to Contact Us, using strict brand tokens.
import { siteContent } from '../content/site';
import { url } from '../utils/url';

const { hero } = siteContent;
---

<section class="py-20 bg-gradient-to-r from-[#0088cc] via-[#0070a8] to-[#003074] text-white text-center relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-8">
    <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-snug">
      {hero.subhead}
    </h2>
    <div>
      <a
        href={url('/contact')}
        data-astro-prefetch="hover"
        class="magnetic-btn inline-flex items-center justify-center px-10 py-4 rounded-xl text-base font-bold text-[#003074] bg-white hover:bg-[#eef7fd] shadow-xl transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-white"
      >
        <span>Get in Touch with Our Team</span>
        <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
