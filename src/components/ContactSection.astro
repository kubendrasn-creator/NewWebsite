---
// ContactSection.astro
// Oversized typographic CTA with magnetic effect, contact form island, and verified office details
import { siteContent } from '../content/site';
import ContactForm from './islands/ContactForm';

const { contact } = siteContent;
---

<section id="contact" class="py-24 sm:py-32 bg-[#eef7fd] border-t border-[#d4e8f7] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Oversized Typographic CTA -->
    <div class="max-w-4xl mb-16 sm:mb-20">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider mb-4 border border-[#d4e8f7] shadow-sm">
        <span>{contact.eyebrow}</span>
      </span>
      <h2
        tabindex="-1"
        class="text-4xl sm:text-6xl font-black text-[#003074] tracking-tight text-balance outline-none"
      >
        {contact.heading}
      </h2>
      <p class="mt-4 text-base sm:text-xl text-[#003074]/80 text-pretty">
        {contact.subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left: Office & Direct Contact Details (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- US Phone Card -->
        <div class="p-6 rounded-2xl bg-white border border-[#d4e8f7] shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#eef7fd] text-[#0070a8] flex items-center justify-center shrink-0 border border-[#d4e8f7]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">United States Office</p>
            <p class="text-base sm:text-lg font-bold text-[#003074]">{contact.phones[0].number}</p>
          </div>
        </div>

        <!-- India Phone Card -->
        <div class="p-6 rounded-2xl bg-white border border-[#d4e8f7] shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#eef7fd] text-[#0070a8] flex items-center justify-center shrink-0 border border-[#d4e8f7]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">India Development Center</p>
            <p class="text-base sm:text-lg font-bold text-[#003074]">{contact.phones[1].number}</p>
          </div>
        </div>

        <!-- Direct Email Card -->
        <div class="p-6 rounded-2xl bg-white border border-[#d4e8f7] shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#eef7fd] text-[#0070a8] flex items-center justify-center shrink-0 border border-[#d4e8f7]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="space-y-1">
            <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">Direct Inquiries</p>
            <p><a href="mailto:info@aptinfosoft.com" class="text-sm font-semibold text-[#0070a8] hover:underline">info@aptinfosoft.com</a></p>
            <p><a href="mailto:sales@aptinfosoft.com" class="text-sm font-semibold text-[#0070a8] hover:underline">sales@aptinfosoft.com</a></p>
          </div>
        </div>

        <!-- India Office Address -->
        <div class="p-6 rounded-2xl bg-white border border-[#d4e8f7] shadow-sm flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#eef7fd] text-[#0070a8] flex items-center justify-center shrink-0 border border-[#d4e8f7]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">Offshore Office Address</p>
            <address class="not-italic text-sm text-[#003074]/90 leading-relaxed font-normal mt-1">
              {contact.address.details}
            </address>
          </div>
        </div>

      </div>

      <!-- Right: Interactive Contact Form Island (7 cols) -->
      <div class="lg:col-span-7 p-8 sm:p-12 rounded-3xl bg-white border border-[#d4e8f7] shadow-lg">
        <ContactForm client:idle />
      </div>

    </div>

  </div>
</section>
