---
// GlobalDeliveryArc.astro
import { getEntry } from 'astro:content';

const siteEntry = await getEntry('site', 'data');
if (!siteEntry) throw new Error('site/data content entry missing');
const { contact } = siteEntry.data;
---

<section class="py-20 bg-[#f6f9fc] border-t border-slate-200 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Visual Global Arc Canvas -->
    <div class="relative w-full max-w-4xl mx-auto p-8 sm:p-12 rounded-3xl bg-white border border-slate-200 shadow-sm mb-10">
      
      <svg viewBox="0 0 800 320" class="w-full h-auto" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="arc-gradient" x1="140" y1="200" x2="660" y2="200" gradientUnits="userSpaceOnUse">
            <stop stop-color="#028ace" />
            <stop offset="0.5" stop-color="#0073df" />
            <stop offset="1" stop-color="#033275" />
          </linearGradient>
        </defs>

        <!-- Background Faint Latitude/Longitude Grid Arc -->
        <path d="M 60 220 Q 400 60, 740 220" stroke="#e2e8f0" stroke-width="2" stroke-dasharray="4 4" />
        <path d="M 60 250 Q 400 90, 740 250" stroke="#f1f5f9" stroke-width="1.5" />

        <!-- High-Velocity Animated Arc between US and Bengaluru -->
        <path
          d="M 160 200 Q 400 40, 640 200"
          stroke="url(#arc-gradient)"
          stroke-width="3.5"
          stroke-linecap="round"
          class="animated-arc"
        />

        <!-- US Node -->
        <g transform="translate(160, 200)">
          <circle cx="0" cy="0" r="16" fill="#028ace" fill-opacity="0.15" class="animate-ping" />
          <circle cx="0" cy="0" r="8" fill="#028ace" />
          <circle cx="0" cy="0" r="3" fill="#ffffff" />
          <text x="0" y="32" text-anchor="middle" font-size="14" font-weight="bold" fill="#033275">US</text>
          <text x="0" y="48" text-anchor="middle" font-size="11" fill="#64748b">(+1) 678-389-2238</text>
        </g>

        <!-- Bengaluru Node -->
        <g transform="translate(640, 200)">
          <circle cx="0" cy="0" r="16" fill="#0073df" fill-opacity="0.15" class="animate-ping" />
          <circle cx="0" cy="0" r="8" fill="#0073df" />
          <circle cx="0" cy="0" r="3" fill="#ffffff" />
          <text x="0" y="32" text-anchor="middle" font-size="14" font-weight="bold" fill="#033275">Bengaluru, India</text>
          <text x="0" y="48" text-anchor="middle" font-size="11" fill="#64748b">+91-9902999224</text>
        </g>
      </svg>

    </div>

    <!-- Verbatim Caption from Efficiency & Contact -->
    <p class="max-w-3xl mx-auto text-lg sm:text-xl text-slate-700 leading-relaxed font-normal">
      {contact.arcCaption}
    </p>

  </div>
</section>
