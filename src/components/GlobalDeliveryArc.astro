---
// GlobalDeliveryArc.astro
import { siteContent } from '../content/site';

const { contact, delivery } = siteContent;
---

<section class="py-20 bg-[#eef7fd] border-t border-[#d4e8f7] overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Visual Global Arc Canvas -->
    <div class="relative w-full max-w-4xl mx-auto p-8 sm:p-12 rounded-3xl bg-white border border-[#d4e8f7] shadow-sm mb-10">
      
      <svg viewBox="0 0 800 320" class="w-full h-auto" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="arc-gradient-standalone" x1="140" y1="200" x2="660" y2="200" gradientUnits="userSpaceOnUse">
            <stop stop-color="#0088cc" />
            <stop offset="0.5" stop-color="#0070a8" />
            <stop offset="1" stop-color="#003074" />
          </linearGradient>
        </defs>

        <!-- Background Faint Grid Arc -->
        <path d="M 60 220 Q 400 60, 740 220" stroke="#d4e8f7" stroke-width="2" stroke-dasharray="4 4" />
        <path d="M 60 250 Q 400 90, 740 250" stroke="#eef7fd" stroke-width="1.5" />

        <!-- High-Velocity Animated Arc between US and Bengaluru -->
        <path
          d="M 160 200 Q 400 40, 640 200"
          stroke="url(#arc-gradient-standalone)"
          stroke-width="3.5"
          stroke-linecap="round"
        />

        <!-- US Node -->
        <g transform="translate(160, 200)">
          <circle cx="0" cy="0" r="16" fill="#0088cc" fill-opacity="0.15" />
          <circle cx="0" cy="0" r="8" fill="#0088cc" />
          <circle cx="0" cy="0" r="3" fill="#ffffff" />
          <text x="0" y="32" text-anchor="middle" font-size="14" font-weight="bold" fill="#003074">United States</text>
          <text x="0" y="48" text-anchor="middle" font-size="11" fill="#0070a8">{contact.phones[0].number}</text>
        </g>

        <!-- Bengaluru Node -->
        <g transform="translate(640, 200)">
          <circle cx="0" cy="0" r="16" fill="#0070a8" fill-opacity="0.15" />
          <circle cx="0" cy="0" r="8" fill="#0070a8" />
          <circle cx="0" cy="0" r="3" fill="#ffffff" />
          <text x="0" y="32" text-anchor="middle" font-size="14" font-weight="bold" fill="#003074">Bengaluru, India</text>
          <text x="0" y="48" text-anchor="middle" font-size="11" fill="#0070a8">{contact.phones[1].number}</text>
        </g>
      </svg>

    </div>

    <!-- Core delivery statement from CONTENT.md -->
    <p class="max-w-3xl mx-auto text-lg sm:text-xl text-[#003074]/90 leading-relaxed font-normal">
      {delivery.coreStatement}
    </p>

  </div>
</section>
