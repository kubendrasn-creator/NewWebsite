---
// src/components/StatementValuesSection.astro
// Verbatim company statement & values from CONTENT.md > ABOUT.
import { siteContent } from '../content/site';

const { about } = siteContent;
---

<section
  id="statement-values"
  class="py-20 sm:py-24 bg-white border-b border-[#d4e8f7]"
  aria-labelledby="statement-heading"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="space-y-3">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#eef7fd] text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7]">
        <span>{about.eyebrow}</span>
      </span>
      <h2 id="statement-heading" class="text-3xl sm:text-4xl font-black text-[#003074] tracking-tight">
        {about.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {about.paragraphs.map((p) => (
        <p class="p-6 rounded-2xl bg-[#eef7fd]/40 border border-[#d4e8f7] text-sm sm:text-base text-[#003074]/90 leading-relaxed">
          {p}
        </p>
      ))}
    </div>
  </div>
</section>
