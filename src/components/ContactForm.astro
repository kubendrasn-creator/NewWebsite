---
// ContactForm.astro
interface Props {
  initialService?: string;
}

const { initialService = '' } = Astro.props;
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';

const serviceOptions = [
  'Product Engineering',
  'Custom Application Development',
  'Software as a Service',
  'Application Modernization',
  'Testing Services',
  'Business Analytics',
  'Career Application',
  'General Technical Inquiry',
];
---

<div class="p-8 sm:p-10 rounded-3xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-lg">
  <form id="contact-form" novalidate class="space-y-6">
    <!-- Web3Forms Config & Honeypot -->
    <input type="hidden" name="access_key" value={web3FormsKey} />
    <input type="hidden" name="subject" value="New Inquiry from Apt Infosoft Website" />
    <input type="hidden" name="from_name" value="Apt Infosoft Lead" />
    <!-- Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

    <!-- Name Field -->
    <div>
      <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
        Full Name <span class="text-teal-600 dark:text-teal-400" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        autocomplete="name"
        placeholder="e.g. Alex Mercer"
        class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder-slate-400 text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all"
        aria-describedby="name-error"
      />
      <p id="name-error" class="hidden mt-1.5 text-xs text-red-600 dark:text-red-400 font-medium" role="alert"></p>
    </div>

    <!-- Email Field -->
    <div>
      <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
        Work Email <span class="text-teal-600 dark:text-teal-400" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        autocomplete="email"
        placeholder="alex@company.com"
        class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder-slate-400 text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all"
        aria-describedby="email-error"
      />
      <p id="email-error" class="hidden mt-1.5 text-xs text-red-600 dark:text-red-400 font-medium" role="alert"></p>
    </div>

    <!-- Company Field -->
    <div>
      <label for="contact-company" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
        Company Name
      </label>
      <input
        type="text"
        id="contact-company"
        name="company"
        autocomplete="organization"
        placeholder="e.g. Acme Corporation"
        class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder-slate-400 text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all"
      />
    </div>

    <!-- Service Interest Dropdown -->
    <div>
      <label for="contact-service" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
        Area of Interest
      </label>
      <select
        id="contact-service"
        name="service"
        class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all cursor-pointer"
      >
        <option value="">Select an engineering practice or inquiry</option>
        {serviceOptions.map((opt) => (
          <option value={opt} selected={initialService.toLowerCase() === opt.toLowerCase()}>
            {opt}
          </option>
        ))}
      </select>
    </div>

    <!-- Message Field -->
    <div>
      <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
        Project Details / Message <span class="text-teal-600 dark:text-teal-400" aria-hidden="true">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        required
        rows="4"
        placeholder="Briefly describe your objectives, current tech stack, or engineering timeline..."
        class="w-full px-4 py-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder-slate-400 text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 focus:outline-none transition-all resize-y"
        aria-describedby="message-error"
      ></textarea>
      <p id="message-error" class="hidden mt-1.5 text-xs text-red-600 dark:text-red-400 font-medium" role="alert"></p>
    </div>

    <!-- Submit Button & Feedback Area -->
    <div class="pt-2">
      <button
        type="submit"
        id="submit-btn"
        class="w-full flex items-center justify-center gap-2 px-6 py-4 rounded-xl text-base font-semibold text-white bg-teal-600 hover:bg-teal-500 disabled:opacity-50 disabled:cursor-not-allowed shadow transition-all focus-visible:outline-2 focus-visible:outline-teal-500 cursor-pointer"
      >
        <span id="btn-idle">Send Message</span>
        <span id="btn-loading" class="hidden items-center gap-2">
          <svg class="animate-spin w-5 h-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Sending...</span>
        </span>
      </button>

      <!-- Success State -->
      <div
        id="form-success"
        class="hidden mt-4 p-4 rounded-xl bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800 text-teal-800 dark:text-teal-200 text-sm"
        role="alert"
      >
        <div class="flex items-center gap-2 font-bold mb-1">
          <svg class="w-5 h-5 text-teal-600 dark:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Message Received</span>
        </div>
        <p>Thank you for reaching out. An engineering lead will review your message and reply within 1 business day.</p>
      </div>

      <!-- Error State -->
      <div
        id="form-error"
        class="hidden mt-4 p-4 rounded-xl bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 text-sm"
        role="alert"
      >
        <div class="flex items-center gap-2 font-bold mb-1">
          <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Unable to Deliver</span>
        </div>
        <p id="error-message-text">Something went wrong. Please try again or email us directly at <a href="mailto:info@aptinfosoft.com" class="underline font-medium">info@aptinfosoft.com</a>.</p>
      </div>

      <p class="mt-4 text-center text-xs text-slate-600 dark:text-slate-400">
        We respect your privacy. No marketing spam, ever.
      </p>
    </div>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    // Check URL parameters for pre-selected role/service
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service') || urlParams.get('role');
    const serviceSelect = document.getElementById('contact-service') as HTMLSelectElement | null;
    if (serviceParam && serviceSelect) {
      // Find matching option or select Career Application
      let matched = false;
      for (const opt of Array.from(serviceSelect.options)) {
        if (opt.value.toLowerCase().includes(serviceParam.toLowerCase()) || serviceParam.toLowerCase().includes(opt.value.toLowerCase())) {
          opt.selected = true;
          matched = true;
          break;
        }
      }
      if (!matched && urlParams.get('role')) {
        for (const opt of Array.from(serviceSelect.options)) {
          if (opt.value === 'Career Application') {
            opt.selected = true;
            break;
          }
        }
        // Pre-fill message with role reference
        const messageBox = document.getElementById('contact-message') as HTMLTextAreaElement | null;
        if (messageBox && !messageBox.value) {
          messageBox.value = `Application for position: ${serviceParam}\n\n`;
        }
      }
    }

    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

    const nameError = document.getElementById('name-error');
    const emailError = document.getElementById('email-error');
    const messageError = document.getElementById('message-error');

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnIdle = document.getElementById('btn-idle');
    const btnLoading = document.getElementById('btn-loading');
    const formSuccess = document.getElementById('form-success');
    const formError = document.getElementById('form-error');
    const errorMessageText = document.getElementById('error-message-text');

    function validateEmail(val: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
    }

    function clearErrors() {
      nameError?.classList.add('hidden');
      emailError?.classList.add('hidden');
      messageError?.classList.add('hidden');
      nameInput?.classList.remove('border-red-500');
      emailInput?.classList.remove('border-red-500');
      messageInput?.classList.remove('border-red-500');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();
      formSuccess?.classList.add('hidden');
      formError?.classList.add('hidden');

      let isValid = true;

      if (!nameInput.value.trim()) {
        if (nameError) {
          nameError.textContent = 'Please enter your name.';
          nameError.classList.remove('hidden');
        }
        nameInput.classList.add('border-red-500');
        isValid = false;
      }

      if (!emailInput.value.trim() || !validateEmail(emailInput.value.trim())) {
        if (emailError) {
          emailError.textContent = 'Please enter a valid work email address.';
          emailError.classList.remove('hidden');
        }
        emailInput.classList.add('border-red-500');
        isValid = false;
      }

      if (!messageInput.value.trim()) {
        if (messageError) {
          messageError.textContent = 'Please provide a message or description of your inquiry.';
          messageError.classList.remove('hidden');
        }
        messageInput.classList.add('border-red-500');
        isValid = false;
      }

      if (!isValid) return;

      // Loading State
      submitBtn.disabled = true;
      btnIdle?.classList.add('hidden');
      btnLoading?.classList.remove('hidden');
      btnLoading?.classList.add('inline-flex');

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (response.ok && data.success) {
          form.reset();
          formSuccess?.classList.remove('hidden');
        } else {
          throw new Error(data.message || 'Submission failed');
        }
      } catch (err: any) {
        if (formError) {
          if (errorMessageText) {
            errorMessageText.textContent = `Submission note: ${err.message || 'Service unavailable'}. Please email info@aptinfosoft.com directly.`;
          }
          formError.classList.remove('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        btnIdle?.classList.remove('hidden');
        btnLoading?.classList.add('hidden');
        btnLoading?.classList.remove('inline-flex');
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>
