---
// ProcessSteps.astro
const steps = [
  {
    step: '01',
    name: 'Discover',
    tagline: 'Understand the business reality',
    description: 'We unpack your commercial requirements, domain constraints, system architectures, and end-user workflows before writing a line of code.',
    deliverables: ['Architecture Audit', 'Scope & Feasibility Analysis', 'Technical Roadmap'],
  },
  {
    step: '02',
    name: 'Design',
    tagline: 'Architect for longevity',
    description: 'We draft component architectures, API contracts, database schemas, and interactive UX prototypes that eliminate ambiguities early.',
    deliverables: ['System Specifications', 'Data Schema Models', 'Clickable Wireframes'],
  },
  {
    step: '03',
    name: 'Build',
    tagline: 'Iterative sprint execution',
    description: 'Working in two-week agile increments, full-stack engineers ship tested, production-grade features with automated continuous integration.',
    deliverables: ['Bi-Weekly Demos', 'Automated CI/CD Builds', 'Source Code Access'],
  },
  {
    step: '04',
    name: 'Test',
    tagline: 'Comprehensive verification',
    description: 'Automated test suites (E2E, integration, API) run alongside manual exploratory testing, performance benchmarks, and security audits.',
    deliverables: ['E2E Automated Suites', 'Security & OWASP Scans', 'Performance Test Reports'],
  },
  {
    step: '05',
    name: 'Support',
    tagline: 'Sustained platform evolution',
    description: 'Post-launch telemetry, proactive infrastructure monitoring, feature enhancements, and SLA-backed maintenance ensure long-term stability.',
    deliverables: ['24/7 Health Monitoring', 'Patching & Upgrades', 'Continuous Feature Sprints'],
  },
];
---

<div class="relative">
  <!-- Desktop timeline connector line -->
  <div class="hidden lg:block absolute top-1/2 left-8 right-8 h-1 bg-gradient-to-r from-[#0073df]/20 via-[#00b4d8]/40 to-[#0073df]/20 -translate-y-12" aria-hidden="true"></div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 relative z-10">
    {steps.map((item) => (
      <div class="group flex flex-col justify-between p-7 rounded-3xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-[#0073df]/50 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
        
        <div>
          <!-- Step Number Badge -->
          <div class="flex items-center justify-between mb-5">
            <span class="w-11 h-11 rounded-2xl bg-gradient-to-br from-[#0073df] to-[#005bb5] text-white font-extrabold text-sm flex items-center justify-center shadow-md shadow-blue-500/20 group-hover:scale-110 transition-transform">
              {item.step}
            </span>
            <span class="text-xs uppercase font-mono font-bold tracking-wider text-[#0073df] dark:text-[#38bdf8]">
              Phase {item.step}
            </span>
          </div>

          <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-1.5 group-hover:text-[#0073df] dark:group-hover:text-[#38bdf8] transition-colors">
            {item.name}
          </h3>
          <p class="text-xs font-semibold text-[#0073df] dark:text-[#38bdf8] mb-3">
            {item.tagline}
          </p>

          <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
            {item.description}
          </p>
        </div>

        <!-- Deliverables Pill List -->
        <div class="pt-4 border-t border-[var(--color-border)]">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5">Key Deliverables</p>
          <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
            {item.deliverables.map((deliv) => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0073df] dark:bg-[#38bdf8]"></span>
                <span>{deliv}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    ))}
  </div>
</div>
