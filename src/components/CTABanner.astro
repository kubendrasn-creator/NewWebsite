---
// CTABanner.astro
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  eyebrow = 'Start Your Project',
  title = 'Ready to engineer software that fits your business?',
  subtitle = 'Schedule a confidential discussion with our engineering leads. We review your architectural challenges and propose a pragmatic path forward.',
  primaryCtaText = 'Talk to us',
  primaryCtaHref = '/contact/',
  secondaryCtaText = 'Explore services',
  secondaryCtaHref = '/services/',
} = Astro.props;
---

<section class="py-24 lg:py-28 bg-gradient-to-br from-[#071120] via-[#0c1b33] to-[#071120] text-white relative overflow-hidden" aria-label="Call to Action">
  <!-- Ambient background glow -->
  <div class="absolute -top-32 right-1/4 w-96 h-96 rounded-full bg-[#0073df]/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-32 left-1/4 w-96 h-96 rounded-full bg-[#00b4d8]/15 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-950/80 border border-blue-500/30 text-[#38bdf8] text-xs font-semibold uppercase tracking-wider mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8] animate-ping"></span>
      <span>{eyebrow}</span>
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white max-w-3xl mx-auto leading-tight mb-6">
      {title}
    </h2>

    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10 font-normal">
      {subtitle}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href={primaryCtaHref}
        class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-[#0073df] via-[#0066cc] to-[#005bb5] hover:from-[#005bb5] hover:to-[#004a94] shadow-xl shadow-blue-600/30 hover:shadow-2xl hover:shadow-blue-600/50 transition-all focus-visible:outline-2 focus-visible:outline-[#38bdf8]"
      >
        <span>{primaryCtaText}</span>
        <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      {secondaryCtaText && (
        <a
          href={secondaryCtaHref}
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-slate-200 hover:text-white bg-slate-800/60 hover:bg-slate-800 border border-slate-700/80 hover:border-slate-500 transition-colors focus-visible:outline-2 focus-visible:outline-[#38bdf8]"
        >
          {secondaryCtaText}
        </a>
      )}
    </div>

    <p class="mt-8 text-xs text-slate-400">
      No sales pressure • Direct engineering consultation • Response within 1 business day
    </p>
  </div>
</section>
