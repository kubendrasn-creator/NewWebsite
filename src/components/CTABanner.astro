---
// CTABanner.astro
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  eyebrow = 'Start Your Project',
  title = 'Ready to engineer software that fits your business?',
  subtitle = 'Schedule a confidential discussion with our engineering leads. We review your architectural challenges and propose a pragmatic path forward.',
  primaryCtaText = 'Talk to us',
  primaryCtaHref = '/contact/',
  secondaryCtaText = 'Explore services',
  secondaryCtaHref = '/services/',
} = Astro.props;
---

<section class="py-20 lg:py-24 bg-gradient-to-br from-navy-950 via-navy-900 to-[#0b1120] text-white relative overflow-hidden" aria-label="Call to Action">
  <!-- Ambient background glow -->
  <div class="absolute -top-32 right-1/4 w-96 h-96 rounded-full bg-teal-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-32 left-1/4 w-96 h-96 rounded-full bg-sky-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-teal-400 mb-4">
      {eyebrow}
    </p>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white max-w-3xl mx-auto leading-tight mb-6">
      {title}
    </h2>

    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10">
      {subtitle}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href={primaryCtaHref}
        class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-white bg-teal-600 hover:bg-teal-500 shadow-lg shadow-teal-950/50 hover:shadow-teal-900/70 transition-all focus-visible:outline-2 focus-visible:outline-teal-400"
      >
        {primaryCtaText}
      </a>
      {secondaryCtaText && (
        <a
          href={secondaryCtaHref}
          class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-slate-200 hover:text-white bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 transition-colors focus-visible:outline-2 focus-visible:outline-teal-400"
        >
          {secondaryCtaText}
        </a>
      )}
    </div>

    <p class="mt-8 text-xs text-slate-300">
      No sales aggressive pressure • Direct engineer consultation • Response within 1 business day
    </p>
  </div>
</section>
