---
// Footer.astro
const currentYear = new Date().getFullYear();

const serviceLinks = [
  { label: 'Product Engineering', href: '/services/product-engineering/' },
  { label: 'Custom App Development', href: '/services/application-development/' },
  { label: 'Software as a Service', href: '/services/saas/' },
  { label: 'Application Modernization', href: '/services/application-modernization/' },
  { label: 'Testing Services', href: '/services/testing/' },
  { label: 'Business Analytics', href: '/services/business-analytics/' },
];

const companyLinks = [
  { label: 'About Us', href: '/about/' },
  { label: 'Engagement Models', href: '/engagement-models/' },
  { label: 'Careers', href: '/careers/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
];
---

<footer class="mt-auto border-t border-slate-800 bg-[#071120] text-slate-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12">
      
      <!-- Brand & Positioning Column (2 cols wide) -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="inline-block focus-visible:outline-2 focus-visible:outline-[#38bdf8] rounded-xl">
          <img
            src="/main_logo2.png"
            alt="Apt Infosoft"
            width="200"
            height="46"
            class="h-10 w-auto object-contain brightness-110 contrast-125"
            loading="lazy"
          />
        </a>

        <p class="text-slate-300 text-sm leading-relaxed max-w-sm">
          Engineering software that fits your business, built to last. Product engineering, custom applications, SaaS, modernization, testing, and analytics delivered through a flexible onsite-offshore model.
        </p>

        <!-- Address & Contact -->
        <address class="not-italic text-sm text-slate-300 space-y-2 pt-2">
          <p class="flex items-start gap-2.5">
            <svg class="w-4 h-4 mt-0.5 text-[#38bdf8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>[TODO: Add corporate office address / Bengaluru, India]</span>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#38bdf8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@aptinfosoft.com" class="hover:text-[#38bdf8] transition-colors font-medium">
              info@aptinfosoft.com
            </a>
          </p>
        </address>

        <!-- Social Links -->
        <div class="pt-2">
          <a
            href="https://www.linkedin.com/company/aptinfosoft"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-slate-300 hover:text-[#38bdf8] transition-colors focus-visible:outline-2 focus-visible:outline-[#38bdf8] rounded-md"
          >
            <svg class="w-5 h-5 fill-current text-[#0073df]" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>Follow on LinkedIn</span>
          </a>
        </div>
      </div>

      <!-- Services Navigation -->
      <nav aria-label="Services Navigation" class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Services
        </h3>
        <ul class="space-y-2.5 text-sm">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-300 hover:text-[#38bdf8] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Company Navigation -->
      <nav aria-label="Company Navigation" class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Company
        </h3>
        <ul class="space-y-2.5 text-sm">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-300 hover:text-[#38bdf8] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Conversion Column -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">
          Start a Conversation
        </h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          Discuss your upcoming software roadmap or project requirements directly with an engineering lead.
        </p>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center w-full px-4 py-3 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-[#0073df] to-[#005bb5] hover:from-[#005bb5] hover:to-[#004a94] shadow-md shadow-blue-500/20 transition-all focus-visible:outline-2 focus-visible:outline-[#38bdf8]"
        >
          Schedule Discussion
        </a>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {currentYear} Apt Infosoft. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy-policy/" class="text-slate-400 hover:text-[#38bdf8] transition-colors">
          Privacy Policy
        </a>
        <a href="/sitemap-index.xml" class="text-slate-400 hover:text-[#38bdf8] transition-colors">
          Sitemap
        </a>
      </div>
    </div>
  </div>
</footer>
