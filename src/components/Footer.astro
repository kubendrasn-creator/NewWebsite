---
// Footer.astro
// Giant wordmark text reveal, unaltered logo, real route nav links, dynamic build year
import { siteContent } from '../content/site';
import { url, asset } from '../utils/url';

const currentYear = new Date().getFullYear();
const logoSrc = asset('logo.png');
---

<footer class="bg-[#003074] text-white pt-20 pb-12 border-t border-[#0088cc]/30 relative overflow-hidden">
  
  <!-- Subtle background glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-[#0088cc]/10 rounded-full blur-3xl pointer-events-none" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16 border-b border-white/10 items-start">
      
      <!-- Logo + Positioning Subhead (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        <a href={url('/')} class="inline-block" aria-label="Apt Infosoft Home">
          <img
            src={logoSrc}
            alt="Apt Infosoft"
            width="220"
            height="50"
            class="h-9 w-auto object-contain brightness-0 invert"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-xs sm:text-sm text-white/90 leading-relaxed max-w-sm">
          {siteContent.hero.subhead}
        </p>
      </div>

      <!-- Quick Nav Links (4 cols) -->
      <div class="md:col-span-4 space-y-3">
        <p class="text-xs font-black uppercase tracking-widest text-white">
          Navigation
        </p>
        <ul class="grid grid-cols-2 gap-2 text-xs sm:text-sm font-semibold text-white/90">
          {siteContent.nav.map((item) => (
            <li>
              <a href={url(item.href)} class="hover:text-white hover:underline transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Direct Contact (3 cols) -->
      <div class="md:col-span-3 space-y-3">
        <p class="text-xs font-black uppercase tracking-widest text-white">
          Offices
        </p>
        <div class="space-y-1.5 text-xs text-white/90">
          <div class="flex items-center justify-between gap-2">
            <span>US: <a href="tel:+16783892238" class="hover:text-white hover:underline transition-colors">(+1) 678-389-2238</a></span>
            <button type="button" class="click-to-copy-btn p-1 rounded hover:bg-white/10 text-white/80 hover:text-white transition-colors" data-copy="+1-678-389-2238" aria-label="Copy US phone number">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          </div>
          <div class="flex items-center justify-between gap-2">
            <span>IND: <a href="tel:+919902999224" class="hover:text-white hover:underline transition-colors">+91-9902999224</a></span>
            <button type="button" class="click-to-copy-btn p-1 rounded hover:bg-white/10 text-white/80 hover:text-white transition-colors" data-copy="+91-9902999224" aria-label="Copy India phone number">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          </div>
          <div class="flex items-center justify-between gap-2">
            <a href="mailto:info@aptinfosoft.com" class="hover:text-white hover:underline transition-colors">info@aptinfosoft.com</a>
            <button type="button" class="click-to-copy-btn p-1 rounded hover:bg-white/10 text-white/80 hover:text-white transition-colors" data-copy="info@aptinfosoft.com" aria-label="Copy email address">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Giant Wordmark Graphic Motif -->
    <div class="pt-12 pb-8 text-center select-none overflow-hidden" aria-hidden="true" role="presentation">
      <svg class="w-full h-16 sm:h-24 lg:h-36 overflow-visible" viewBox="0 0 1000 120" fill="none" aria-hidden="true">
        <text
          x="50%"
          y="50%"
          dominant-baseline="central"
          text-anchor="middle"
          fill="rgba(255, 255, 255, 0.08)"
          font-size="110"
          font-weight="900"
          letter-spacing="4"
          font-family="system-ui, sans-serif"
        >
          APT INFOSOFT
        </text>
      </svg>
    </div>

    <!-- Bottom Copyright Line & Accessibility Controls -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/80 pt-6 border-t border-white/10">
      <p>© 2017–{currentYear} Apt Infosoft. All rights reserved.</p>
      
      <!-- Pause Motion Accessibility Control (WCAG 2.2.2) -->
      <div class="flex items-center gap-4">
        <button
          id="pause-motion-toggle"
          type="button"
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-white/20 text-xs font-semibold text-white/90 hover:bg-white/10 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-white"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="pause-motion-text">Pause motion</span>
        </button>
        <p class="text-white/70 hidden sm:block">Engineering software built to last.</p>
      </div>
    </div>

  </div>
</footer>
