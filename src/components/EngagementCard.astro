---
// EngagementCard.astro
interface Props {
  title: string;
  badge?: string;
  tagline: string;
  description: string;
  bestFor: string;
  deliverables: string[];
  ctaText?: string;
  highlighted?: boolean;
}

const {
  title,
  badge,
  tagline,
  description,
  bestFor,
  deliverables,
  ctaText = 'Discuss this model',
  highlighted = false,
} = Astro.props;
---

<div
  class={`relative flex flex-col justify-between p-8 sm:p-10 rounded-3xl transition-all duration-300 ${
    highlighted
      ? 'border-2 border-teal-500 bg-gradient-to-b from-teal-950/20 via-[var(--color-card-bg)] to-[var(--color-card-bg)] shadow-xl shadow-teal-950/10'
      : 'border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-teal-500/40 hover:shadow-lg'
  }`}
>
  {badge && (
    <div class="absolute -top-3.5 left-8 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-600 text-white shadow-sm">
      {badge}
    </div>
  )}

  <div>
    <!-- Title & Tagline -->
    <h3 class="text-2xl font-bold text-navy-900 dark:text-white mb-2">
      {title}
    </h3>
    <p class="text-sm font-semibold text-teal-600 dark:text-teal-400 mb-4">
      {tagline}
    </p>

    <!-- Description -->
    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6">
      {description}
    </p>

    <!-- Best For Section -->
    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-[var(--color-border)] mb-6">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
        Best Suited For
      </p>
      <p class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200">
        {bestFor}
      </p>
    </div>

    <!-- Deliverables / Features -->
    <div class="space-y-3 mb-8">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Engagement Highlights
      </p>
      <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
        {deliverables.map((item) => (
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 mt-0.5 text-teal-600 dark:text-teal-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- CTA Link -->
  <div class="pt-6 border-t border-[var(--color-border)]">
    <a
      href="/contact/"
      class={`inline-flex items-center justify-center w-full px-5 py-3 rounded-xl text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-teal-500 ${
        highlighted
          ? 'bg-teal-600 text-white hover:bg-teal-500 shadow-md'
          : 'bg-slate-100 dark:bg-slate-800 text-navy-900 dark:text-white hover:bg-teal-50 dark:hover:bg-teal-950/40 hover:text-teal-600 dark:hover:text-teal-400'
      }`}
    >
      {ctaText}
    </a>
  </div>
</div>
