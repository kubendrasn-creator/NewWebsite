---
// EngagementCard.astro
interface Props {
  title: string;
  badge?: string;
  tagline: string;
  description: string;
  bestFor: string;
  deliverables: string[];
  ctaText?: string;
  highlighted?: boolean;
}

const {
  title,
  badge,
  tagline,
  description,
  bestFor,
  deliverables,
  ctaText = 'Discuss this model',
  highlighted = false,
} = Astro.props;
---

<div
  class={`relative flex flex-col justify-between p-8 sm:p-10 rounded-3xl transition-all duration-300 ${
    highlighted
      ? 'border-2 border-[#0073df] bg-gradient-to-b from-blue-950/20 via-[var(--color-card-bg)] to-[var(--color-card-bg)] shadow-2xl shadow-blue-500/15 ring-4 ring-blue-500/10'
      : 'border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-[#0073df]/50 hover:shadow-xl'
  } hover:-translate-y-1`}
>
  {badge && (
    <div class="absolute -top-3.5 left-8 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-[#0073df] to-[#005bb5] text-white shadow-md shadow-blue-500/25">
      {badge}
    </div>
  )}

  <div>
    <!-- Title & Tagline -->
    <h3 class="text-2xl font-bold text-navy-900 dark:text-white mb-2">
      {title}
    </h3>
    <p class="text-sm font-semibold text-[#0073df] dark:text-[#38bdf8] mb-4">
      {tagline}
    </p>

    <!-- Description -->
    <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6 font-normal">
      {description}
    </p>

    <!-- Best For Section -->
    <div class="p-4 rounded-2xl bg-blue-50/60 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/60 mb-6">
      <p class="text-xs font-bold uppercase tracking-wider text-[#0073df] dark:text-[#38bdf8] mb-1">
        Best Suited For
      </p>
      <p class="text-xs sm:text-sm font-medium text-slate-800 dark:text-slate-200">
        {bestFor}
      </p>
    </div>

    <!-- Deliverables / Features -->
    <div class="space-y-3 mb-8">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
        Engagement Highlights
      </p>
      <ul class="space-y-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
        {deliverables.map((item) => (
          <li class="flex items-start gap-2.5">
            <div class="w-4 h-4 rounded-full bg-blue-100 dark:bg-blue-950 text-[#0073df] dark:text-[#38bdf8] flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="leading-snug">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- CTA Link -->
  <div class="pt-6 border-t border-[var(--color-border)]">
    <a
      href="/contact/"
      class={`inline-flex items-center justify-center w-full px-5 py-3.5 rounded-xl text-sm font-bold transition-all focus-visible:outline-2 focus-visible:outline-[#0073df] cursor-pointer ${
        highlighted
          ? 'bg-gradient-to-r from-[#0073df] to-[#005bb5] hover:from-[#005bb5] hover:to-[#004a94] text-white shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40'
          : 'bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-100 hover:bg-blue-50 dark:hover:bg-blue-950/60 hover:text-[#0073df] dark:hover:text-[#38bdf8]'
      }`}
    >
      {ctaText}
    </a>
  </div>
</div>
