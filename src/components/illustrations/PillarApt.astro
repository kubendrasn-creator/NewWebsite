---
// PillarApt.astro — "No two businesses are alike."
// Mismatched shapes rotate and slot into an interlocking form.
// 3 parallax layers (data-parallax-depth). Brand colors only.
---

<svg
  viewBox="0 0 200 200"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="w-full h-full"
  style="max-height: 320px;"
>
  <!-- Layer 1: background ring (slow parallax) -->
  <g data-parallax-depth="0.1">
    <circle cx="100" cy="100" r="80" fill="none" stroke="#eef7fd" stroke-width="2" opacity="0.6" />
    <circle cx="100" cy="100" r="60" fill="none" stroke="#d4e8f7" stroke-width="1.5" opacity="0.4" />
  </g>

  <!-- Layer 2: mid shapes before interlocking (medium parallax) -->
  <g data-parallax-depth="0.3">
    <!-- Shape A: tall rotated hexagon fragment - Navy -->
    <polygon
      class="apt-shape-a"
      points="78,55 92,45 106,55 106,80 92,90 78,80"
      fill="#003074"
      opacity="0.85"
    />
    <!-- Shape B: angled rectangle - Brand Blue -->
    <rect
      class="apt-shape-b"
      x="98" y="100" width="38" height="52" rx="6"
      fill="#0088cc"
      opacity="0.9"
    />
    <!-- Shape C: small diamond - ice fill -->
    <polygon
      points="62,118 76,105 90,118 76,131"
      fill="#eef7fd"
      stroke="#0070a8"
      stroke-width="2"
      opacity="0.9"
    />
  </g>

  <!-- Layer 3: interlocked swoosh mark (foreground) -->
  <g data-parallax-depth="0.6">
    <!-- Swoosh "i" dot -->
    <ellipse cx="100" cy="52" rx="12" ry="9" fill="#0088cc" opacity="0.95" />
    <!-- Swoosh stem -->
    <path
      d="M 94 68 Q 88 100 92 148"
      fill="none"
      stroke="#003074"
      stroke-width="10"
      stroke-linecap="round"
    />
    <!-- Swoosh tail -->
    <path
      d="M 92 148 Q 100 158 114 152 Q 128 146 124 136"
      fill="none"
      stroke="#0088cc"
      stroke-width="8"
      stroke-linecap="round"
    />
    <!-- Connecting line showing "fit" -->
    <line x1="78" y1="90" x2="98" y2="100" stroke="#0070a8" stroke-width="2.5" stroke-dasharray="4 3" opacity="0.7" />
  </g>

  <!-- Decorative plus marks -->
  <g opacity="0.3" stroke="#0088cc" stroke-width="1.5">
    <line x1="30" y1="30" x2="30" y2="40" /><line x1="25" y1="35" x2="35" y2="35" />
    <line x1="165" y1="155" x2="165" y2="165" /><line x1="160" y1="160" x2="170" y2="160" />
  </g>
</svg>
