---
// ServiceModernization.astro — Old Monolith Block Morphing to Modern Microservice Blocks
// Illustrates Application Modernization.
---

<svg
  viewBox="0 0 240 160"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="w-full h-auto max-h-40"
>
  <!-- Left: Legacy Monolithic Heavy Block -->
  <g transform="translate(42, 45)">
    <!-- Heavy textured monolith block with sharp corners -->
    <rect
      x="0"
      y="0"
      width="64"
      height="64"
      rx="2"
      fill="#eef7fd"
      stroke="#003074"
      stroke-width="2.5"
    />
    <!-- Cracks / legacy divisions -->
    <line x1="0" y1="22" x2="64" y2="22" stroke="#003074" stroke-width="1.5" stroke-dasharray="2 2" />
    <line x1="0" y1="44" x2="64" y2="44" stroke="#003074" stroke-width="1.5" stroke-dasharray="2 2" />
    <line x1="32" y1="0" x2="32" y2="64" stroke="#003074" stroke-width="1.5" stroke-dasharray="2 2" />
    <text x="32" y="80" text-anchor="middle" font-size="9" fill="#003074" font-weight="700">Legacy Core</text>
  </g>

  <!-- Transition Bridge: Decomposition & Modernization Arrows -->
  <g transform="translate(112, 77)">
    <line x1="0" y1="0" x2="24" y2="0" stroke="#0088cc" stroke-width="2.5" stroke-dasharray="4 2" />
    <polygon points="26,0 20,-4 20,4" fill="#0088cc" />
  </g>

  <!-- Right: Modern Modular Architecture (Interconnected Agile Blocks) -->
  <g transform="translate(148, 35)">
    <!-- Module A -->
    <rect class="svc-morph" x="0" y="0" width="34" height="34" rx="8" fill="#0088cc" />
    <circle cx="17" cy="17" r="4" fill="#ffffff" />

    <!-- Module B -->
    <rect class="svc-morph" x="44" y="0" width="34" height="34" rx="8" fill="#0070a8" />
    <rect x="56" y="12" width="10" height="10" rx="2" fill="#ffffff" />

    <!-- Module C -->
    <rect class="svc-morph" x="0" y="44" width="34" height="34" rx="8" fill="#003074" />
    <polygon points="17,54 24,66 10,66" fill="#ffffff" />

    <!-- Module D -->
    <rect class="svc-morph" x="44" y="44" width="34" height="34" rx="8" fill="#eef7fd" stroke="#0088cc" stroke-width="2" />
    <circle cx="61" cy="61" r="5" fill="#0088cc" />

    <!-- Inter-service connection lines -->
    <line x1="34" y1="17" x2="44" y2="17" stroke="#003074" stroke-width="2" />
    <line x1="17" y1="34" x2="17" y2="44" stroke="#0088cc" stroke-width="2" />
    <line x1="61" y1="34" x2="61" y2="44" stroke="#0070a8" stroke-width="2" />
    <line x1="34" y1="61" x2="44" y2="61" stroke="#003074" stroke-width="2" />

    <text x="39" y="100" text-anchor="middle" font-size="9" fill="#003074" font-weight="700">Modernized Microservices</text>
  </g>
</svg>
