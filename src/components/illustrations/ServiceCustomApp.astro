---
// ServiceCustomApp.astro — Three Devices: Mobile, Web/Laptop, Desktop
// Illustrates Custom Application Development across multi-platform experiences.
---

<svg
  viewBox="0 0 240 160"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="w-full h-auto max-h-40"
>
  <!-- Background soft pulse -->
  <rect x="15" y="15" width="210" height="130" rx="16" fill="#eef7fd" opacity="0.6" />

  <!-- Device 1: Desktop Screen (Back / Center-left) -->
  <g transform="translate(30, 25)">
    <!-- Monitor frame -->
    <rect x="0" y="0" width="120" height="78" rx="6" fill="#ffffff" stroke="#003074" stroke-width="2" />
    <!-- Window top bar -->
    <rect x="0" y="0" width="120" height="14" rx="6" fill="#003074" />
    <circle cx="8" cy="7" r="2.5" fill="#ffffff" opacity="0.7" />
    <circle cx="16" cy="7" r="2.5" fill="#ffffff" opacity="0.7" />
    <circle cx="24" cy="7" r="2.5" fill="#ffffff" opacity="0.7" />
    <!-- Monitor content wireframe -->
    <rect x="8" y="20" width="30" height="48" rx="3" fill="#eef7fd" />
    <rect x="44" y="22" width="68" height="10" rx="2" fill="#0088cc" opacity="0.85" />
    <rect x="44" y="36" width="45" height="6" rx="2" fill="#d4e8f7" />
    <rect x="44" y="46" width="60" height="6" rx="2" fill="#d4e8f7" />
    <!-- Stand -->
    <rect x="52" y="78" width="16" height="16" fill="#003074" />
    <rect x="40" y="94" width="40" height="4" rx="2" fill="#003074" />
  </g>

  <!-- Device 2: Laptop / Tablet (Overlapping Center-right) -->
  <g transform="translate(100, 48)">
    <rect x="0" y="0" width="90" height="58" rx="5" fill="#ffffff" stroke="#0070a8" stroke-width="2" />
    <rect x="6" y="6" width="78" height="42" rx="2" fill="#eef7fd" />
    <line x1="12" y1="16" x2="48" y2="16" stroke="#0088cc" stroke-width="2" stroke-linecap="round" />
    <line x1="12" y1="24" x2="68" y2="24" stroke="#003074" stroke-width="2" stroke-linecap="round" />
    <line x1="12" y1="32" x2="40" y2="32" stroke="#d4e8f7" stroke-width="2" stroke-linecap="round" />
    <!-- Laptop base -->
    <path d="M -8 58 L 98 58 L 90 64 L -2 64 Z" fill="#0070a8" />
  </g>

  <!-- Device 3: Smartphone (Foreground Right) -->
  <g transform="translate(182, 40)">
    <rect x="0" y="0" width="38" height="74" rx="8" fill="#ffffff" stroke="#003074" stroke-width="2.5" />
    <!-- Speaker & Camera notch -->
    <rect x="12" y="4" width="14" height="2" rx="1" fill="#003074" />
    <!-- Screen area -->
    <rect x="3" y="10" width="32" height="54" rx="3" fill="#eef7fd" />
    <!-- App layout lines -->
    <circle cx="10" cy="18" r="4" fill="#0088cc" />
    <rect x="17" y="16" width="14" height="4" rx="1" fill="#003074" />
    <rect x="6" y="26" width="26" height="14" rx="3" fill="#0088cc" opacity="0.9" />
    <rect x="6" y="44" width="26" height="6" rx="2" fill="#d4e8f7" />
    <rect x="6" y="53" width="18" height="6" rx="2" fill="#d4e8f7" />
    <!-- Home bar -->
    <line x1="13" y1="68" x2="25" y2="68" stroke="#003074" stroke-width="2" stroke-linecap="round" />
  </g>
</svg>
