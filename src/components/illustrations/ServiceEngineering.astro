---
// ServiceEngineering.astro — Concept to Product Flow
// Illustrates Product Engineering: concept spark -> blueprint node -> finished gear/product.
---

<svg
  viewBox="0 0 240 160"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="w-full h-auto max-h-40"
>
  <defs>
    <linearGradient id="eng-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0088cc" />
      <stop offset="100%" stop-color="#003074" />
    </linearGradient>
  </defs>

  <!-- Flow pipeline connector with animated dash -->
  <path
    d="M 35 80 L 115 80 L 195 80"
    fill="none"
    stroke="#d4e8f7"
    stroke-width="3"
    stroke-linecap="round"
  />
  <path
    class="svc-flow"
    d="M 35 80 L 115 80 L 195 80"
    fill="none"
    stroke="url(#eng-grad)"
    stroke-width="3"
    stroke-linecap="round"
  />

  <!-- Stage 1: Idea / Concept (Wireframe Hexagon & Spark) -->
  <g transform="translate(35, 80)">
    <circle r="24" fill="#eef7fd" stroke="#0070a8" stroke-width="1.5" stroke-dasharray="3 3" />
    <!-- Idea lightbulb / spark motif -->
    <path
      d="M -7 -6 C -7 -13, 7 -13, 7 -6 C 7 -2, 3 1, 3 5 L -3 5 C -3 1, -7 -2, -7 -6 Z"
      fill="none"
      stroke="#0088cc"
      stroke-width="2"
      stroke-linejoin="round"
    />
    <line x1="-3" y1="8" x2="3" y2="8" stroke="#0070a8" stroke-width="2" stroke-linecap="round" />
    <text y="38" text-anchor="middle" font-size="9" fill="#003074" font-weight="700">Concept</text>
  </g>

  <!-- Stage 2: Architecture & Blueprint (Connected Micro-modules) -->
  <g transform="translate(115, 80)">
    <rect x="-24" y="-24" width="48" height="48" rx="8" fill="#ffffff" stroke="#0070a8" stroke-width="2" />
    <!-- Blueprint architectural grid lines -->
    <line x1="-16" y1="-8" x2="16" y2="-8" stroke="#d4e8f7" stroke-width="1.5" />
    <line x1="-16" y1="0" x2="16" y2="0" stroke="#0088cc" stroke-width="1.5" />
    <line x1="-16" y1="8" x2="8" y2="8" stroke="#d4e8f7" stroke-width="1.5" />
    <!-- Node indicator -->
    <circle cx="10" cy="8" r="3" fill="#003074" />
    <text y="38" text-anchor="middle" font-size="9" fill="#003074" font-weight="700">Blueprint</text>
  </g>

  <!-- Stage 3: Engineered Product (Solid Precision Gear + Forward Badge) -->
  <g transform="translate(195, 80)">
    <circle r="24" fill="#003074" />
    <!-- Cog/Gear teeth -->
    <path
      d="M -4 -26 L 4 -26 L 3 -21 L -3 -21 Z
         M -4 26 L 4 26 L 3 21 L -3 21 Z
         M -26 -4 L -26 4 L -21 3 L -21 -3 Z
         M 26 -4 L 26 4 L 21 3 L 21 -3 Z"
      fill="#003074"
    />
    <circle r="16" fill="#0088cc" />
    <circle r="7" fill="#ffffff" />
    <text y="38" text-anchor="middle" font-size="9" fill="#003074" font-weight="700">Product</text>
  </g>
</svg>
