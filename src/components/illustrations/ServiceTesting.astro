---
// ServiceTesting.astro — Manual and Automated Lanes Merging into Quality Stream
// Illustrates Comprehensive Testing & QA Services.
---

<svg
  viewBox="0 0 240 160"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="w-full h-auto max-h-40"
>
  <!-- Background Track Rails -->
  <!-- Lane 1: Manual Testing (Upper track) -->
  <g transform="translate(20, 40)">
    <text x="0" y="-10" font-size="9" fill="#003074" font-weight="700">Manual Track</text>
    <path
      d="M 10 12 L 80 12 Q 110 12 130 40"
      fill="none"
      stroke="#d4e8f7"
      stroke-width="3"
    />
    <path
      class="svc-lane"
      d="M 10 12 L 80 12 Q 110 12 130 40"
      fill="none"
      stroke="#0070a8"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="8 6"
    />
    <!-- Manual inspection magnifying glass -->
    <circle cx="36" cy="12" r="7" fill="#ffffff" stroke="#003074" stroke-width="2" />
    <line x1="41" y1="17" x2="47" y2="23" stroke="#003074" stroke-width="2.5" stroke-linecap="round" />
  </g>

  <!-- Lane 2: Automated Testing (Lower track) -->
  <g transform="translate(20, 100)">
    <text x="0" y="30" font-size="9" fill="#0088cc" font-weight="700">Automated Pipeline</text>
    <path
      d="M 10 -12 L 80 -12 Q 110 -12 130 -40"
      fill="none"
      stroke="#d4e8f7"
      stroke-width="3"
    />
    <path
      class="svc-lane"
      d="M 10 -12 L 80 -12 Q 110 -12 130 -40"
      fill="none"
      stroke="#0088cc"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray="14 4"
    />
    <!-- Script / Terminal automated gear symbol -->
    <rect x="26" y="-20" width="16" height="14" rx="2" fill="#0088cc" />
    <text x="34" y="-10" text-anchor="middle" font-size="8" fill="#ffffff" font-weight="bold">&gt;_</text>
  </g>

  <!-- Merged Highway & Verification Checkpoint (Right) -->
  <g transform="translate(150, 70)">
    <line x1="0" y1="10" x2="40" y2="10" stroke="#003074" stroke-width="4" stroke-linecap="round" />
    <!-- Quality Seal / Passed Badge -->
    <circle cx="58" cy="10" r="18" fill="#003074" />
    <circle cx="58" cy="10" r="14" fill="#0088cc" />
    <!-- Verified Checkmark -->
    <path
      d="M 52 10 L 56 14 L 65 6"
      fill="none"
      stroke="#ffffff"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <text x="58" y="38" text-anchor="middle" font-size="9" fill="#003074" font-weight="800">Verified</text>
  </g>
</svg>
