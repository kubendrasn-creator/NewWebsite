---
// ServiceAnalytics.astro — Scattered Dots Converging into Structured Insights Chart
// Illustrates Business Reporting & Analytics.
---

<svg
  viewBox="0 0 240 160"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="w-full h-auto max-h-40"
>
  <!-- Background Chart Grid Lines -->
  <g stroke="#d4e8f7" stroke-width="1.5" opacity="0.6">
    <line x1="120" y1="25" x2="215" y2="25" />
    <line x1="120" y1="55" x2="215" y2="55" />
    <line x1="120" y1="85" x2="215" y2="85" />
    <line x1="120" y1="115" x2="215" y2="115" />
    <line x1="120" y1="20" x2="120" y2="120" stroke="#003074" stroke-width="2" />
    <line x1="118" y1="120" x2="218" y2="120" stroke="#003074" stroke-width="2" />
  </g>

  <!-- Left: Scattered, Unstructured Data Points (Animated) -->
  <g transform="translate(15, 20)">
    <text x="40" y="10" text-anchor="middle" font-size="9" fill="#003074" font-weight="700">Raw Data</text>
    
    <!-- Cluster of scattered raw data dots with convergence animations -->
    <circle class="svc-dot" cx="20" cy="30" r="4" fill="#0070a8" style="--tx: 80px; --ty: 40px;" />
    <circle class="svc-dot" cx="48" cy="24" r="3.5" fill="#0088cc" style="--tx: 60px; --ty: 30px;" />
    <circle class="svc-dot" cx="65" cy="42" r="5" fill="#003074" style="--tx: 45px; --ty: 20px;" />
    <circle class="svc-dot" cx="28" cy="65" r="4.5" fill="#0088cc" style="--tx: 75px; --ty: -10px;" />
    <circle class="svc-dot" cx="55" cy="75" r="3" fill="#0070a8" style="--tx: 50px; --ty: -15px;" />
    <circle class="svc-dot" cx="18" cy="95" r="5" fill="#003074" style="--tx: 85px; --ty: -30px;" />
    <circle class="svc-dot" cx="72" cy="98" r="3.5" fill="#0088cc" style="--tx: 30px; --ty: -35px;" />
    <circle class="svc-dot" cx="44" cy="110" r="4" fill="#0070a8" style="--tx: 60px; --ty: -50px;" />

    <!-- Connecting convergence flow streams -->
    <path
      d="M 65 60 C 85 60, 95 70, 105 70"
      fill="none"
      stroke="#0088cc"
      stroke-width="1.5"
      stroke-dasharray="3 3"
    />
  </g>

  <!-- Right: Synthesized Visual Insights (Bars + Trend Line) -->
  <g transform="translate(120, 0)">
    <!-- Bar 1 -->
    <rect x="15" y="80" width="14" height="40" rx="3" fill="#eef7fd" stroke="#0070a8" stroke-width="1.5" />
    <!-- Bar 2 -->
    <rect x="37" y="55" width="14" height="65" rx="3" fill="#d4e8f7" stroke="#0088cc" stroke-width="1.5" />
    <!-- Bar 3 -->
    <rect x="59" y="40" width="14" height="80" rx="3" fill="#0088cc" />
    <!-- Bar 4 -->
    <rect x="81" y="25" width="14" height="95" rx="3" fill="#003074" />

    <!-- Overlay Trend Line -->
    <path
      d="M 22 75 L 44 50 L 66 35 L 88 18"
      fill="none"
      stroke="#003074"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="22" cy="75" r="3.5" fill="#ffffff" stroke="#003074" stroke-width="2" />
    <circle cx="44" cy="50" r="3.5" fill="#ffffff" stroke="#003074" stroke-width="2" />
    <circle cx="66" cy="35" r="3.5" fill="#ffffff" stroke="#003074" stroke-width="2" />
    <circle cx="88" cy="18" r="4" fill="#0088cc" stroke="#003074" stroke-width="2" />

    <text x="50" y="142" text-anchor="middle" font-size="9" fill="#003074" font-weight="700">Decisions &amp; Insights</text>
  </g>
</svg>
