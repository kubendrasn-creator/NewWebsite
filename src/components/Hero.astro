---
// Hero.astro
// WebGL aurora mesh canvas + CSS animated fallback + kinetic per-word masked reveal
import { siteContent } from '../content/site';

const { hero } = siteContent;
---

<section id="top" class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
  
  <!-- Fallback CSS Animated Mesh Gradient (@property driven) -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#ffffff] via-[#eef7fd] to-[#f5fafe] -z-20 pointer-events-none" />

  <!-- Lazy-loaded WebGL Shader Canvas -->
  <canvas
    id="hero-webgl-canvas"
    class="absolute inset-0 w-full h-full -z-10 pointer-events-none transition-opacity duration-700 opacity-0"
    aria-hidden="true"
  />

  <!-- Subtle Logo 'i' Swoosh Watermark in Background -->
  <div class="absolute right-[-5%] top-[15%] w-[45vw] max-w-[600px] aspect-square -z-10 opacity-[0.035] pointer-events-none">
    <svg viewBox="0 0 100 100" fill="currentColor" class="w-full h-full text-[#003074]">
      <path d="M 32 24 C 42 16, 68 18, 76 28 C 72 32, 58 36, 48 30 Z" />
      <path d="M 45 42 L 53 84" stroke="currentColor" stroke-width="12" stroke-linecap="round" />
    </svg>
  </div>

  <div class="max-w-5xl mx-auto text-center relative z-10 space-y-8">
    
    <!-- Top Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#eef7fd] border border-[#d4e8f7] text-[#0070a8] text-xs font-bold uppercase tracking-wider shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[#0088cc] animate-pulse" />
      <span>{hero.badge}</span>
    </div>

    <!-- Kinetic Per-Word Masked Reveal Headline -->
    <h1 class="hero-kinetic-headline text-4xl sm:text-6xl lg:text-7xl font-black text-[#003074] tracking-tight leading-[1.08] text-balance">
      <span class="inline-block overflow-hidden py-1">
        <span class="word-inner inline-block">No</span>
      </span>{' '}
      <span class="inline-block overflow-hidden py-1">
        <span class="word-inner inline-block">two</span>
      </span>{' '}
      <span class="inline-block overflow-hidden py-1">
        <span class="word-inner inline-block">businesses</span>
      </span>{' '}
      <span class="inline-block overflow-hidden py-1">
        <span class="word-inner inline-block italic text-[#0088cc]">are alike.</span>
      </span>
    </h1>

    <!-- Subhead (Facts from CONTENT.md) -->
    <p class="max-w-3xl mx-auto text-base sm:text-xl text-[#003074]/85 leading-relaxed font-normal text-pretty">
      {hero.subhead}
    </p>

    <!-- CTAs: Two Magnetic Buttons -->
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4 sm:gap-6">
      <a
        href={hero.primaryHref}
        class="magnetic-btn inline-flex items-center justify-center px-8 py-4 rounded-xl text-sm sm:text-base font-bold text-white bg-[#0070a8] hover:bg-[#003074] shadow-lg shadow-blue-900/15 transition-all duration-200"
      >
        <span>{hero.primaryCTA}</span>
        <span class="ml-2">→</span>
      </a>

      <a
        href={hero.secondaryHref}
        class="magnetic-btn inline-flex items-center justify-center px-8 py-4 rounded-xl text-sm sm:text-base font-bold text-[#003074] bg-white border-2 border-[#d4e8f7] hover:border-[#0088cc] hover:text-[#0088cc] hover:bg-[#eef7fd]/50 transition-all duration-200"
      >
        <span>{hero.secondaryCTA}</span>
      </a>
    </div>

    <!-- Scroll Cue -->
    <div class="pt-12 flex flex-col items-center gap-2 opacity-70 hover:opacity-100 transition-opacity">
      <span class="text-xs font-bold uppercase tracking-widest text-[#003074]">
        {hero.scrollCue}
      </span>
      <div class="w-5 h-9 rounded-full border-2 border-[#003074]/40 flex items-start justify-center p-1">
        <div class="w-1.5 h-2 rounded-full bg-[#0088cc] animate-bounce" />
      </div>
    </div>

  </div>
</section>

<script>
  // Cut WebGL on mobile devices per rule (1): fallback to CSS animated mesh gradient
  if (typeof window !== 'undefined' && window.innerWidth >= 768 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => {
        loadShader();
      });
    } else {
      setTimeout(loadShader, 200);
    }
  }

  async function loadShader() {
    const canvas = document.getElementById('hero-webgl-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    try {
      const { initHeroShader } = await import('../scripts/hero-webgl');
      const cleanup = initHeroShader(canvas);
      if (cleanup) {
        canvas.classList.remove('opacity-0');
        canvas.classList.add('opacity-100');
      }
    } catch (e) {
      // Graceful fallback to CSS gradient
    }
  }
</script>
