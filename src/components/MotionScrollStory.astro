---
// src/components/MotionScrollStory.astro
// Scene B: 5-Beat Scroll Story driven by pure functions renderBeat(idx, progress)
// Captions sit on solid white beside the stage with CSS-only per-word mask reveals.
import { siteContent } from '../content/site';
import { renderBeat } from '../motion/scene-engine';

const beats = siteContent.motionBeats;
const initialSvgs = beats.map((_, idx) => renderBeat(idx, 0.65).svg);
---

<section
  id="motion-story"
  class="py-20 sm:py-28 bg-white border-b border-[#d4e8f7] relative"
  aria-label="Engineering Story"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#eef7fd] text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7]">
        <span>How We Engineer</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-[#003074] tracking-tight">
        Precision in Four Beats
      </h2>
      <!-- 4-Beat Indicator Dots -->
      <div class="flex items-center justify-center gap-2 pt-2" aria-hidden="true">
        {beats.map((_, idx) => (
          <span
            class="motion-story-dot w-2.5 h-2.5 rounded-full bg-[#d4e8f7] transition-colors duration-200"
            data-dot-index={idx}
          />
        ))}
      </div>
    </div>

    <div class="space-y-8">
      {beats.map((beat, idx) => {
        const words = beat.caption.split(' ');
        const isEven = idx % 2 === 0;
        return (
          <article
            class="motion-beat-row min-h-[85svh] py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
            data-beat-index={idx}
          >
            {/* Stage (400x300 pure SVG on solid white) */}
            <div
              class={`lg:col-span-6 ${isEven ? 'lg:order-1' : 'lg:order-2'}`}
            >
              <div class="bg-white border border-[#d4e8f7] rounded-3xl p-4 sm:p-6 shadow-sm">
                <div
                  class="motion-beat-stage w-full aspect-[4/3] flex items-center justify-center overflow-hidden rounded-2xl bg-white"
                  set:html={initialSvgs[idx]}
                />
              </div>
            </div>

            {/* Caption on solid white beside the stage */}
            <div
              class={`lg:col-span-6 bg-white space-y-4 ${isEven ? 'lg:order-2' : 'lg:order-1'}`}
            >
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded-lg bg-[#eef7fd] border border-[#d4e8f7] text-xs font-mono font-bold text-[#0070a8]">
                  0{idx + 1} / 0{beats.length}
                </span>
                <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
                  {beat.title}
                </span>
              </div>

              <p class="kinetic-caption text-2xl sm:text-3xl font-bold text-[#003074] leading-snug">
                {words.map((word, wIdx) => (
                  <>
                    <span class="inline-block overflow-hidden align-bottom py-0.5">
                      <span
                        class="kinetic-word inline-block"
                        style={`--word-delay: ${wIdx * 40}ms;`}
                      >
                        {word}
                      </span>
                    </span>
                    {wIdx < words.length - 1 ? ' ' : ''}
                  </>
                ))}
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .kinetic-word {
    transform: translateY(105%);
    opacity: 0;
    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1) var(--word-delay, 0ms),
      opacity 350ms ease var(--word-delay, 0ms);
  }

  .motion-beat-row.is-active .kinetic-word {
    transform: translateY(0%);
    opacity: 1;
  }

  /* Instant when reduced motion or Pause Motion is active */
  @media (prefers-reduced-motion: reduce) {
    .kinetic-word {
      transform: translateY(0%);
      opacity: 1;
      transition: none;
    }
  }

  :global(html[data-motion="paused"]) .kinetic-word {
    transform: translateY(0%);
    opacity: 1;
    transition: none;
  }
</style>

<script>
  import { renderBeat } from '../motion/scene-engine';

  let cleanupStory: (() => void) | null = null;

  function initMotionScrollStory() {
    if (cleanupStory) {
      cleanupStory();
      cleanupStory = null;
    }

    const rows = Array.from(document.querySelectorAll<HTMLElement>('.motion-beat-row'));
    if (!rows.length) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isPaused = () =>
      prefersReduced || document.documentElement.getAttribute('data-motion') === 'paused';

    // Reveal captions on intersection
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
          }
        }
      },
      { threshold: 0.2 }
    );

    rows.forEach((row) => observer.observe(row));

    let rafId: number | null = null;

    function updateBeatsFromScroll() {
      rafId = null;
      const vh = window.innerHeight || 800;

      for (const row of rows) {
        const idx = Number(row.dataset.beatIndex || 0);
        const stage = row.querySelector<HTMLElement>('.motion-beat-stage');
        if (!stage) continue;

        if (isPaused()) {
          stage.innerHTML = renderBeat(idx, 0.65).svg;
          continue;
        }

        const rect = row.getBoundingClientRect();
        // Map viewport traversal from bottom (0.92 * vh) to center (0.48 * vh) into [0, 1]
        const startY = vh * 0.92;
        const endY = vh * 0.48;
        const centerY = rect.top + rect.height * 0.5;
        const rawP = (startY - centerY) / (startY - endY);
        const p = Math.max(0, Math.min(1, rawP));

        // Only re-render if visible or near viewport
        if (rect.bottom >= -100 && rect.top <= vh + 100) {
          stage.innerHTML = renderBeat(idx, p).svg;
        }
      }
    }

    function onScroll() {
      if (rafId === null) {
        rafId = window.requestAnimationFrame(updateBeatsFromScroll);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    updateBeatsFromScroll();

    cleanupStory = () => {
      observer.disconnect();
      window.removeEventListener('scroll', onScroll);
      if (rafId !== null) window.cancelAnimationFrame(rafId);
    };
  }

  document.addEventListener('astro:page-load', initMotionScrollStory);
  document.addEventListener('astro:before-swap', () => {
    if (cleanupStory) {
      cleanupStory();
      cleanupStory = null;
    }
  });
</script>
