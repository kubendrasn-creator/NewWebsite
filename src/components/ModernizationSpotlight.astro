---
// src/components/ModernizationSpotlight.astro
// Reusable Application Modernization spotlight + accessible Before/After comparison slider.
// When isStatic=true, renders only the Modern 4:3 SVG frame (for /services/application-modernization/ hero).
import { siteContent } from '../content/site';
import { renderModernizationFrame } from '../motion/scene-engine';
import { url } from '../utils/url';

interface Props {
  isStatic?: boolean;
}

const { isStatic = false } = Astro.props;
const legacySvg = renderModernizationFrame(0.0);
const modernSvg = renderModernizationFrame(0.65);

const modService = siteContent.services.find((s) => s.slug === 'application-modernization')!;
---

{isStatic ? (
  <div
    class="w-full aspect-[4/3] flex items-center justify-center overflow-hidden rounded-2xl bg-white"
    aria-label="Modernized application architecture"
    set:html={modernSvg}
  />
) : (
  <section
    id="modernization-spotlight"
    class="py-20 sm:py-28 bg-white border-b border-[#d4e8f7]"
    aria-labelledby="modernization-spotlight-heading"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

        <!-- Left Column: Copy & Actions -->
        <div class="lg:col-span-6 space-y-6">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#eef7fd] text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7]">
            <span>Application Modernization</span>
          </span>

          <h2
            id="modernization-spotlight-heading"
            class="text-3xl sm:text-4xl font-black text-[#003074] tracking-tight leading-tight"
          >
            {modService.title}
          </h2>

          <p class="text-base sm:text-lg text-[#003074]/90 leading-relaxed font-normal">
            We help you to migrate your legacy code into newer platforms that provides you with all the advantages of latest technology along with lower product maintenance cost.
          </p>

          <p class="text-base sm:text-lg text-[#003074]/90 leading-relaxed font-normal">
            {modService.fullDescription}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href={url('/services/application-modernization')}
              data-astro-prefetch="hover"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl text-sm sm:text-base font-bold text-white bg-[#0070a8] hover:bg-[#003074] shadow-md shadow-blue-900/10 transition-colors"
            >
              <span>Explore</span>
              <span class="ml-2" aria-hidden="true">→</span>
            </a>

            <a
              href={url('/contact')}
              data-astro-prefetch="hover"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl text-sm sm:text-base font-bold text-[#003074] bg-white border-2 border-[#d4e8f7] hover:border-[#0088cc] hover:text-[#0088cc] hover:bg-[#eef7fd]/50 transition-colors"
            >
              <span>Contact Us</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Before/After Interactive Comparison -->
        <div class="lg:col-span-6">
          <div class="bg-[#eef7fd]/50 border border-[#d4e8f7] rounded-3xl p-4 sm:p-6 shadow-sm">
            <div
              class="spotlight-compare relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-white border border-[#d4e8f7] select-none"
              style="--pos: 50;"
            >
              <!-- Base Layer: Legacy Frame -->
              <div class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true" set:html={legacySvg} />

              <!-- Clipped Top Layer: Modern Frame -->
              <div
                class="spotlight-modern-layer absolute inset-0 w-full h-full pointer-events-none"
                style="clip-path: inset(0 0 0 calc(var(--pos, 50) * 1%));"
                aria-hidden="true"
                set:html={modernSvg}
              />

              <!-- Corner Labels -->
              <span class="absolute top-3 left-3 z-10 px-2.5 py-1 rounded-lg bg-white/95 border border-[#d4e8f7] text-xs font-bold text-[#003074] pointer-events-none">
                Legacy
              </span>
              <span class="absolute top-3 right-3 z-10 px-2.5 py-1 rounded-lg bg-[#0070a8] text-xs font-bold text-white pointer-events-none">
                Modern
              </span>

              <!-- Vertical Divider Line & Visual Thumb -->
              <div
                class="spotlight-divider absolute top-0 bottom-0 w-0.5 bg-[#0070a8] pointer-events-none z-20"
                style="left: calc(var(--pos, 50) * 1%); transform: translateX(-50%);"
                aria-hidden="true"
              >
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-[#0070a8] border-2 border-white shadow-lg flex items-center justify-center text-white">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 3 12 9 6" />
                    <polyline points="15 6 21 12 15 18" />
                  </svg>
                </div>
              </div>

              <!-- Native Accessible Range Input Overlay -->
              <input
                type="range"
                min="0"
                max="100"
                step="1"
                value="50"
                aria-label="Compare legacy and modern"
                aria-valuetext="50% modern"
                class="spotlight-range absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30 m-0"
              />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
)}

<style>
  .spotlight-modern-layer,
  .spotlight-divider {
    transition: none;
  }

  .spotlight-range:focus-visible ~ .spotlight-divider > div {
    outline: 3px solid #003074;
    outline-offset: 2px;
  }
</style>

<script>
  function initModernizationSpotlights() {
    const containers = document.querySelectorAll<HTMLElement>('.spotlight-compare');
    containers.forEach((container) => {
      const range = container.querySelector<HTMLInputElement>('.spotlight-range');
      if (!range || range.dataset.bound === 'true') return;
      range.dataset.bound = 'true';

      const sync = (val: number) => {
        const clamped = Math.max(0, Math.min(100, val));
        range.value = String(clamped);
        container.style.setProperty('--pos', String(clamped));
        range.setAttribute('aria-valuetext', `${clamped}% modern`);
      };

      range.addEventListener('input', () => {
        sync(Number(range.value));
      });

      range.addEventListener('keydown', (e) => {
        const cur = Number(range.value);
        if (e.key === 'PageUp') {
          e.preventDefault();
          sync(cur + 10);
        } else if (e.key === 'PageDown') {
          e.preventDefault();
          sync(cur - 10);
        } else if (e.key === 'Home') {
          e.preventDefault();
          sync(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          sync(100);
        }
      });

      sync(Number(range.value || 50));
    });
  }

  document.addEventListener('astro:page-load', initModernizationSpotlights);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initModernizationSpotlights();
  }
</script>
