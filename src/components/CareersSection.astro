---
// CareersSection.astro
// Two role cards with hover-reveal and their 'No Openings' status states
import { siteContent } from '../content/site';

const { careers } = siteContent;
---

<section id="careers" class="py-24 sm:py-32 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#eef7fd] text-[#0070a8] text-xs font-bold uppercase tracking-wider mb-4 border border-[#d4e8f7]">
        <span>{careers.eyebrow}</span>
      </span>
      <h2
        tabindex="-1"
        class="text-3xl sm:text-5xl font-black text-[#003074] tracking-tight outline-none"
      >
        {careers.title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#003074]/80">
        {careers.subtitle}
      </p>
    </div>

    <!-- Two Role Cards with Hover Reveal -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl">
      {careers.roles.map((role) => (
        <div class="group relative p-8 sm:p-10 rounded-3xl bg-[#f5fafe] border-2 border-[#d4e8f7] shadow-sm transition-all duration-300 hover:border-[#0088cc] hover:shadow-xl hover:-translate-y-1 overflow-hidden flex flex-col justify-between">
          
          <!-- Top subtle glow on hover -->
          <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-[#0088cc] to-[#003074] opacity-0 group-hover:opacity-100 transition-opacity" />

          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">
                {role.department}
              </span>
              <span class="px-3 py-1 rounded-full bg-slate-200/80 text-slate-700 text-xs font-bold uppercase">
                Status
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
              {role.title}
            </h3>

            <p class="text-xs sm:text-sm text-[#003074]/70 font-medium">
              {role.statusDetail}
            </p>
          </div>

          <!-- Status badge indicator (CONTENT.md verified fact) -->
          <div class="mt-8 pt-6 border-t border-[#d4e8f7] flex items-center justify-between">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 border border-slate-200 text-xs sm:text-sm font-bold text-slate-600">
              <span class="w-2 h-2 rounded-full bg-slate-400" />
              <span>{role.status}</span>
            </div>

            <a
              href="#contact"
              class="text-xs font-bold text-[#0070a8] hover:underline"
            >
              General Inquiries →
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
