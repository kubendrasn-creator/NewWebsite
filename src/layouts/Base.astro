---
// src/layouts/Base.astro - Multi-page Light Mode Only with ClientRouter
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { url, asset, BASE_URL } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object | object[];
}

const {
  title = 'Apt Infosoft – Engineering Software Built to Last',
  description = 'Product engineering, custom application development, cloud SaaS, application modernization, testing, and business reporting & analytics for SMEs.',
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://kubendrasn-creator.github.io').toString();
const logoUrl = 'https://kubendrasn-creator.github.io/NewWebsite/logo.png';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Apt Infosoft",
  "url": "https://kubendrasn-creator.github.io/NewWebsite/",
  "logo": logoUrl,
  "email": "info@aptinfosoft.com",
  "telephone": ["+1-678-389-2238", "+91-9902999224"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "4th Floor Vista Pixel, Vista Spaces, Jakkuru Layout",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560092",
    "addressCountry": "IN"
  }
};
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: light;" data-direction="forward">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href={asset('logo.png')} />
    <link rel="apple-touch-icon" href={asset('logo.png')} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:site_name" content="Apt Infosoft" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />

    <!-- Font Family Plus Jakarta Sans -->
    <style is:inline>
      @font-face {
        font-family: 'Plus Jakarta Sans';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: local('Plus Jakarta Sans'), local('Inter'), system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>

    <!-- Astro ClientRouter for View Transitions with fallback -->
    <ClientRouter fallback="animate" />

    <!-- Direction determination for ~8° Slanted Transition Wipe -->
    <script is:inline define:vars={{ BASE_URL }}>
      (function() {
        var navOrder = [
          BASE_URL + '/',
          BASE_URL + '/services/',
          BASE_URL + '/why-apt/',
          BASE_URL + '/about/',
          BASE_URL + '/careers/',
          BASE_URL + '/contact/'
        ];

        document.addEventListener('astro:before-preparation', function(event) {
          var fromPath = window.location.pathname.replace(/\/$/, '') || '/';
          var toPath = new URL(event.to).pathname.replace(/\/$/, '') || '/';

          var fromIdx = -1;
          var toIdx = -1;
          for (var i = 0; i < navOrder.length; i++) {
            var p = navOrder[i].replace(/\/$/, '');
            if (fromPath === p || (p !== BASE_URL && fromPath.indexOf(p) === 0)) fromIdx = i;
            if (toPath === p || (p !== BASE_URL && toPath.indexOf(p) === 0)) toIdx = i;
          }

          var direction = 'forward';
          if (fromIdx !== -1 && toIdx !== -1) {
            direction = toIdx < fromIdx ? 'back' : 'forward';
          }
          document.documentElement.setAttribute('data-direction', direction);
        });
      })();
    </script>

    <!-- Structured Data Organization JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Page Specific JSON-LD Schema -->
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
      />
    )}
  </head>
  <body class="bg-white text-[#003074] antialiased min-h-screen flex flex-col relative selection:bg-[#0088cc] selection:text-white">
    
    <!-- Scroll Progress Bar -->
    <div id="scroll-progress-bar" aria-hidden="true" />

    <!-- Subtle Film Grain Overlay -->
    <div class="grain-overlay" aria-hidden="true" />

    <!-- Persistent Custom Cursor across ClientRouter transitions -->
    <div id="cursor-dot" transition:persist="cursor-dot" aria-hidden="true"></div>
    <div id="cursor-ring" transition:persist="cursor-ring" aria-hidden="true">
      <span id="cursor-ring-label">View</span>
    </div>

    <!-- Accessible Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2.5 focus:bg-[#0070a8] focus:text-white focus:rounded-xl focus:shadow-xl focus:outline-none font-bold text-xs uppercase tracking-wider"
    >
      Skip to main content
    </a>

    <!-- Polite Live Region for Route Change Announcements -->
    <div id="a11y-route-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    <!-- Persistent Header across transitions -->
    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Load Unified Motion & Lifecycle Engine -->
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
