---
// src/pages/contact.astro
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import ContactForm from '../components/islands/ContactForm';
import GlobalDeliveryArc from '../components/GlobalDeliveryArc.astro';

const siteEntry = await getEntry('site', 'data');
if (!siteEntry) throw new Error('site/data content entry missing');
const { contact } = siteEntry.data;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact Us",
      "item": "https://aptinfosoft.com/contact/"
    }
  ]
};
---

<Base
  title="Contact Us – Apt Infosoft"
  description="Contact Apt Infosoft: US and India office information, direct emails, and project inquiry form."
  jsonLd={breadcrumbSchema}
>
  <!-- Hero -->
  <section class="py-20 lg:py-28 bg-[#f6f9fc] border-b border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-[#033275] text-xs font-bold uppercase tracking-wider mb-4">
        <span>Get in Touch</span>
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#033275] tracking-tight mb-6">
        Contact Us
      </h1>
    </div>
  </section>

  <!-- Form + Details Section -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Contact Details Cards (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- US Phone -->
          <div class="p-6 rounded-2xl border border-slate-200 bg-[#f6f9fc] shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#005bb5] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-0.5">United States</p>
              <p class="text-base font-bold text-[#033275]">{contact.usPhone}</p>
            </div>
          </div>

          <!-- IND Phone -->
          <div class="p-6 rounded-2xl border border-slate-200 bg-[#f6f9fc] shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#005bb5] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-0.5">India</p>
              <p class="text-base font-bold text-[#033275]">{contact.indPhone}</p>
            </div>
          </div>

          <!-- Emails -->
          <div class="p-6 rounded-2xl border border-slate-200 bg-[#f6f9fc] shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#005bb5] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="space-y-1">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-0.5">Direct Email</p>
              <p><a href="mailto:info@aptinfosoft.com" class="text-sm font-semibold text-[#005bb5] hover:underline">{contact.generalEmail}</a></p>
              <p><a href="mailto:sales@aptinfosoft.com" class="text-sm font-semibold text-[#005bb5] hover:underline">{contact.salesEmail}</a></p>
            </div>
          </div>

          <!-- Address in India -->
          <div class="p-6 rounded-2xl border border-slate-200 bg-[#f6f9fc] shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#005bb5] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-0.5">India Office</p>
              <address class="not-italic text-sm text-slate-700 leading-relaxed font-normal">
                {contact.indiaAddress}
              </address>
            </div>
          </div>

        </div>

        <!-- Right: Contact Form Island (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm client:idle />
        </div>

      </div>
    </div>
  </section>

  <!-- Global Delivery Arc Visual -->
  <GlobalDeliveryArc />
</Base>
