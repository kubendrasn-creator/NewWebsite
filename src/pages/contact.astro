---
// src/pages/contact.astro
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL || '';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact",
      "item": "https://aptinfosoft.com/contact/"
    }
  ]
};
---

<Base
  title="Contact Apt Infosoft – Let's Engineer Together"
  description="Connect with our software engineering leads. Schedule an architectural consultation or submit project requirements."
  jsonLd={breadcrumbSchema}
>
  <!-- Contact Hero -->
  <section class="py-20 lg:py-24 bg-gradient-to-b from-[#071120] via-[#0c1b33] to-[#071120] text-white text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-950/80 border border-blue-500/30 text-[#38bdf8] text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8] animate-ping"></span>
        <span>Direct Technical Consultation</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-6">
        Let's Talk About Your Project
      </h1>
      <p class="text-base sm:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Speak directly with an engineering lead. No sales scripts or pushy tactics — just an honest assessment of your technical needs and timeline.
      </p>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="py-20 lg:py-24 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Column: Contact Info & Value Props (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <SectionHeading
              eyebrow="Communication Channels"
              title="Straightforward Conversations"
              subtitle="Whether you have complete product specifications or an early architectural dilemma, we are ready to assist."
              align="left"
            />
          </div>

          <!-- Contact Details Cards -->
          <div class="space-y-4">
            
            <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-sm flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-[#0073df] dark:text-[#38bdf8] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-bold text-navy-900 dark:text-white mb-0.5">Direct Email</h2>
                <a href="mailto:info@aptinfosoft.com" class="text-xs sm:text-sm text-[#0073df] dark:text-[#38bdf8] hover:underline">
                  info@aptinfosoft.com
                </a>
                <p class="text-[11px] text-slate-400 mt-1">Monitored continuously by engineering leadership</p>
              </div>
            </div>

            <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-sm flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-[#0073df] dark:text-[#38bdf8] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-bold text-navy-900 dark:text-white mb-0.5">Corporate Office</h2>
                <address class="not-italic text-xs sm:text-sm text-slate-600 dark:text-slate-400">
                  [TODO: Add corporate office address / City, Country]
                </address>
                <p class="text-[11px] text-slate-400 mt-1">Available for onsite workshops by appointment</p>
              </div>
            </div>

            <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-sm flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-[#0073df] dark:text-[#38bdf8] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-bold text-navy-900 dark:text-white mb-0.5">LinkedIn</h2>
                <a
                  href="https://in.linkedin.com/company/apt-infosoft-pvt-ltd"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs sm:text-sm text-[#0073df] dark:text-[#38bdf8] hover:underline"
                >
                  linkedin.com/company/apt-infosoft-pvt-ltd
                </a>
                <p class="text-[11px] text-slate-400 mt-1">Connect with our company updates and team members</p>
              </div>
            </div>

          </div>

          <!-- What to expect banner -->
          <div class="p-6 rounded-2xl bg-blue-50/70 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-900/60">
            <h2 class="text-sm font-bold text-navy-900 dark:text-blue-200 mb-2">Our Commitment to You:</h2>
            <ul class="space-y-1.5 text-xs text-slate-700 dark:text-blue-300">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0073df] dark:bg-[#38bdf8]"></span>
                <span>Response from an engineering principal within 1 business day</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0073df] dark:bg-[#38bdf8]"></span>
                <span>Mutual Non-Disclosure Agreement (NDA) upfront upon request</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0073df] dark:bg-[#38bdf8]"></span>
                <span>Transparent scoping with zero aggressive sales follow-ups</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Right Column: Interactive Contact Form (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>

      <!-- Optional Calendly / Cal.com Section (controlled by env var PUBLIC_CALENDLY_URL; hidden if unset) -->
      {calendlyUrl ? (
        <div class="mt-24 pt-16 border-t border-[var(--color-border)]">
          <SectionHeading
            eyebrow="Instant Scheduling"
            title="Book an Architecture Discovery Call"
            subtitle="Prefer to lock in an immediate 30-minute introductory meeting on your calendar? Pick a slot below."
          />
          <div class="mt-10 rounded-2xl overflow-hidden border border-[var(--color-border)] shadow-md bg-white">
            <iframe
              src={calendlyUrl}
              width="100%"
              height="700"
              frameborder="0"
              title="Schedule consultation"
              loading="lazy"
            ></iframe>
          </div>
        </div>
      ) : (
        <div class="mt-16 p-4 rounded-xl border border-dashed border-slate-300 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40 text-center max-w-xl mx-auto text-xs text-slate-400 font-mono">
          [Note: Add PUBLIC_CALENDLY_URL environment variable to activate inline meeting scheduler]
        </div>
      )}

    </div>
  </section>
</Base>
