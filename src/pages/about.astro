---
// src/pages/about.astro
import Base from '../layouts/Base.astro';
import { getEntry, getCollection } from 'astro:content';
import AudienceSelector from '../components/islands/AudienceSelector';
import CTABand from '../components/CTABand.astro';

const siteEntry = await getEntry('site', 'data');
if (!siteEntry) throw new Error('site/data content entry missing');
const { about } = siteEntry.data;

const audienceList = await getCollection('audience');
const sortedAudience = audienceList.sort((a, b) => a.data.order - b.data.order);

const servicesList = await getCollection('services');
const serviceMetas = servicesList
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({
    id: s.data.id,
    shortTitle: s.data.shortTitle,
    href: `/services/${s.data.id}/`,
  }));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About Us",
      "item": "https://aptinfosoft.com/about/"
    }
  ]
};
---

<Base
  title="About Us – Apt Infosoft"
  description={about.p1.slice(0, 155)}
  jsonLd={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="py-20 lg:py-28 bg-[#f6f9fc] border-b border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-[#033275] text-xs font-bold uppercase tracking-wider mb-4">
        <span>{about.eyebrow}</span>
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#033275] tracking-tight mb-6">
        {about.heading}
      </h1>
    </div>
  </section>

  <!-- Narrative Section -->
  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 text-base sm:text-xl text-slate-700 leading-relaxed font-normal">
      <div class="p-8 sm:p-10 rounded-3xl bg-[#f6f9fc] border border-slate-200 shadow-sm space-y-6">
        <p>
          {about.p1}
        </p>
        <p>
          {about.p2}
        </p>
      </div>
    </div>
  </section>

  <!-- Who can benefit from our engagement? -->
  <section class="py-24 bg-[#f6f9fc] border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-black text-[#033275] tracking-tight">
          {about.audienceHeading}
        </h2>
      </div>

      <AudienceSelector
        client:visible
        items={sortedAudience.map((a) => ({
          id: a.data.id,
          letter: a.data.letter,
          text: a.data.text,
          matchedServices: a.data.matchedServices,
        }))}
        services={serviceMetas}
      />
    </div>
  </section>

  <CTABand />
</Base>
