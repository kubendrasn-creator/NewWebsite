---
// src/pages/efficiency.astro
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import CTABand from '../components/CTABand.astro';

const whyEntry = await getEntry('whyApt', 'efficiency');
if (!whyEntry) throw new Error('whyApt/efficiency content entry missing');
const { title, pageTitle, body } = whyEntry.data;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": pageTitle,
      "item": "https://aptinfosoft.com/efficiency/"
    }
  ]
};
---

<Base
  title={`${pageTitle} – Apt Infosoft`}
  description={body ? body.slice(0, 155) : title}
  jsonLd={breadcrumbSchema}
>
  <section class="py-20 lg:py-28 bg-[#f6f9fc] border-b border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-[#033275] text-xs font-bold uppercase tracking-wider mb-4">
        <span>Why Apt</span>
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#033275] tracking-tight mb-6">
        {pageTitle}
      </h1>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl bg-[#f6f9fc] border border-slate-200 shadow-sm">
        <p class="text-base sm:text-xl text-slate-800 leading-relaxed font-normal">
          {body}
        </p>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
