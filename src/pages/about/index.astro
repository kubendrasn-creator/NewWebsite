---
// src/pages/about/index.astro
import Base from '../../layouts/Base.astro';
import { siteContent } from '../../content/site';
import CTABand from '../../components/CTABand.astro';

const { about } = siteContent;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteContent.meta.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About Us",
      "item": `${siteContent.meta.url}about/`
    }
  ]
};
---

<Base
  title="About Us – Driving Efficiency Through Globalization | Apt Infosoft"
  description="Apt Infosoft provides high quality, reliable, world-class software development services for small and mid-sized enterprises (SME)."
  jsonLd={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-24 bg-[#eef7fd]/50 border-b border-[#d4e8f7] text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider mb-4 border border-[#d4e8f7]">
        <span class="w-2 h-2 rounded-full bg-[#0088cc]"></span>
        <span>{about.eyebrow}</span>
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-[#003074] tracking-tight mb-6">
        {about.title}
      </h1>
    </div>
  </section>

  <!-- Narrative Section with Scroll-Linked Text Fill -->
  <section class="py-24 bg-white border-b border-[#d4e8f7]" id="about-narrative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="p-8 sm:p-12 rounded-3xl bg-[#eef7fd]/30 border border-[#d4e8f7] shadow-xl shadow-blue-900/5 space-y-8">
        {about.paragraphs.map((p) => {
          const words = p.split(/\s+/);
          return (
            <p class="text-xl sm:text-2xl font-semibold leading-relaxed tracking-tight text-[#0070a8]">
              {words.map((word) => (
                <span class="about-reveal-word transition-colors duration-150 inline-block mr-1.5">
                  {word}
                </span>
              ))}
            </p>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Who can benefit from our engagement? (Bug Fix A: Independently Expandable Cards) -->
  <section class="py-24 bg-[#eef7fd]/40 border-b border-[#d4e8f7]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7]">
          <span>Strategic Engagement</span>
        </span>
        <h2 class="text-3xl sm:text-5xl font-black text-[#003074] tracking-tight">
          {about.audienceHeading}
        </h2>
      </div>

      <!-- Grid with items-start ensures cards expand independently without shifting others -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        {about.audienceItems.map((item) => (
          <div class="rounded-3xl bg-white border border-[#d4e8f7] shadow-lg shadow-blue-900/5 overflow-hidden transition-all duration-300 hover:border-[#0088cc]/60">
            <!-- Header Toggle Button -->
            <button
              type="button"
              class="benefit-card-toggle w-full p-6 sm:p-8 flex items-center justify-between text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-[#0070a8]"
              aria-expanded="false"
              aria-controls={`benefit-panel-${item.id}`}
            >
              <div class="flex items-center gap-4">
                <span class="w-12 h-12 rounded-2xl bg-[#eef7fd] text-[#0070a8] border border-[#d4e8f7] font-black text-xl flex items-center justify-center shrink-0">
                  {item.letter}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-[#003074]">
                  {item.title}
                </h3>
              </div>

              <!-- Animated SVG Chevron -->
              <div class="benefit-chevron w-8 h-8 rounded-full bg-[#eef7fd] text-[#0070a8] flex items-center justify-center shrink-0 ml-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </button>

            <!-- Collapsible Panel Wrapper (Bug Fix A) -->
            <div id={`benefit-panel-${item.id}`} class="benefit-panel-wrapper overflow-hidden">
              <div class="overflow-hidden min-h-0 px-6 pb-8 sm:px-8 sm:pb-8 pt-4 space-y-6 border-t border-transparent transition-colors">
                <p class="text-base sm:text-lg text-[#003074]/85 leading-relaxed">
                  {item.description}
                </p>

                <div class="space-y-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-[#0070a8] block">
                    Relevant Services:
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {item.matchedServices.map((svc) => (
                      <span class="inline-flex items-center px-3 py-1 rounded-xl text-xs font-semibold bg-[#eef7fd] text-[#003074] border border-[#d4e8f7]">
                        {svc}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</Base>
