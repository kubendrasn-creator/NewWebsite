---
// src/pages/contact/index.astro
import Base from '../../layouts/Base.astro';
import { siteContent } from '../../content/site';
import ContactForm from '../../components/islands/ContactForm';
import DeliverySection from '../../components/DeliverySection.astro';

const { contact } = siteContent;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteContent.meta.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact Us",
      "item": `${siteContent.meta.url}contact/`
    }
  ]
};
---

<Base
  title="Contact Us – Onshore & Offshore Engagement | Apt Infosoft"
  description="Contact Apt Infosoft: US and India office phone numbers, direct emails, Bengaluru address, and technical consultation form."
  jsonLd={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="pt-44 pb-20 sm:pt-52 sm:pb-24 bg-[#eef7fd]/50 border-b border-[#d4e8f7] text-center" style="padding-top: max(180px, calc(var(--header-h, 120px) + 4.5rem));">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0070a8] text-xs font-bold uppercase tracking-wider mb-4 border border-[#d4e8f7]">
        <span class="w-2 h-2 rounded-full bg-[#0088cc]"></span>
        <span>{contact.eyebrow}</span>
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-[#003074] tracking-tight mb-6">
        {contact.heading}
      </h1>
      <p class="text-lg sm:text-xl text-[#003074]/80 max-w-2xl mx-auto leading-relaxed">
        {contact.subheading}
      </p>
    </div>
  </section>

  <!-- Contact Form & Details Grid -->
  <section class="py-24 bg-white border-b border-[#d4e8f7]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Direct Phone, Email, & India Address (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- US Phone -->
          <div class="p-6 sm:p-8 rounded-3xl border border-[#d4e8f7] bg-[#eef7fd]/40 shadow-sm flex items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-white text-[#0070a8] border border-[#d4e8f7] flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8] mb-1">United States</p>
                <a href={contact.phones[0].href} class="text-lg font-bold text-[#003074] hover:text-[#0088cc] transition-colors">
                  {contact.phones[0].number}
                </a>
              </div>
            </div>
            <button
              type="button"
              class="click-to-copy-btn p-2 rounded-xl bg-white border border-[#d4e8f7] text-[#0070a8] hover:bg-[#eef7fd] hover:text-[#003074] transition-colors focus-visible:outline-2 focus-visible:outline-[#0070a8]"
              data-copy={contact.phones[0].number}
              aria-label="Copy US phone number"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          </div>

          <!-- India Phone -->
          <div class="p-6 sm:p-8 rounded-3xl border border-[#d4e8f7] bg-[#eef7fd]/40 shadow-sm flex items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-white text-[#0070a8] border border-[#d4e8f7] flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8] mb-1">India</p>
                <a href={contact.phones[1].href} class="text-lg font-bold text-[#003074] hover:text-[#0088cc] transition-colors">
                  {contact.phones[1].number}
                </a>
              </div>
            </div>
            <button
              type="button"
              class="click-to-copy-btn p-2 rounded-xl bg-white border border-[#d4e8f7] text-[#0070a8] hover:bg-[#eef7fd] hover:text-[#003074] transition-colors focus-visible:outline-2 focus-visible:outline-[#0070a8]"
              data-copy={contact.phones[1].number}
              aria-label="Copy India phone number"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          </div>

          <!-- Direct Emails -->
          <div class="p-6 sm:p-8 rounded-3xl border border-[#d4e8f7] bg-[#eef7fd]/40 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-white text-[#0070a8] border border-[#d4e8f7] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="space-y-3 flex-1">
              <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">Direct Emails</p>
              <div class="flex items-center justify-between gap-2">
                <div>
                  <span class="text-xs text-[#003074]/70 block">{contact.emails[0].label}:</span>
                  <a href={`mailto:${contact.emails[0].email}`} class="text-base font-bold text-[#003074] hover:text-[#0088cc] transition-colors">
                    {contact.emails[0].email}
                  </a>
                </div>
                <button
                  type="button"
                  class="click-to-copy-btn p-1.5 rounded-lg border border-[#d4e8f7] bg-white text-[#0070a8] hover:bg-[#eef7fd] transition-colors"
                  data-copy={contact.emails[0].email}
                  aria-label="Copy general inquiry email"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
              <div class="flex items-center justify-between gap-2 pt-1 border-t border-[#d4e8f7]/50">
                <div>
                  <span class="text-xs text-[#003074]/70 block">{contact.emails[1].label}:</span>
                  <a href={`mailto:${contact.emails[1].email}`} class="text-base font-bold text-[#003074] hover:text-[#0088cc] transition-colors">
                    {contact.emails[1].email}
                  </a>
                </div>
                <button
                  type="button"
                  class="click-to-copy-btn p-1.5 rounded-lg border border-[#d4e8f7] bg-white text-[#0070a8] hover:bg-[#eef7fd] transition-colors"
                  data-copy={contact.emails[1].email}
                  aria-label="Copy sales inquiry email"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- India Physical Address -->
          <div class="p-6 sm:p-8 rounded-3xl border border-[#d4e8f7] bg-[#eef7fd]/40 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-white text-[#0070a8] border border-[#d4e8f7] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-[#0070a8] mb-1">Offshore Center ({contact.address.country})</p>
              <p class="text-sm sm:text-base font-medium text-[#003074]/90 leading-relaxed">
                {contact.address.details}
              </p>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Consultation Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-12 rounded-3xl bg-white border border-[#d4e8f7] shadow-xl shadow-blue-900/5">
            <div class="mb-8">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-[#003074] tracking-tight mb-2">
                Send Project Scoping Request
              </h2>
              <p class="text-sm sm:text-base text-[#003074]/75">
                Tell us about your project or application requirements. We will review your goals and schedule a technical consultation.
              </p>
            </div>
            <ContactForm client:visible />
            <p class="text-xs text-[#003074]/70 text-center mt-4">
              We use the details you send only to reply to your enquiry.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Global Delivery Route Arc -->
  <DeliverySection />
</Base>
