---
// src/pages/index.astro
// Single-page, award-level static website for Apt Infosoft
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import PillarsScrollStory from '../components/PillarsScrollStory.astro';
import ServicesSection from '../components/ServicesSection.astro';
import DeliverySection from '../components/DeliverySection.astro';
import WhyAptSection from '../components/WhyAptSection.astro';
import AboutSection from '../components/AboutSection.astro';
import CareersSection from '../components/CareersSection.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Base>
  <!-- 1. HERO -->
  <Hero />

  <!-- 2. MARQUEE -->
  <Marquee />

  <!-- 3. PILLARS (Apt / Agile / Assured) -->
  <PillarsScrollStory />

  <!-- 4. SERVICES (Bento Grid + View Transition Modal) -->
  <ServicesSection />

  <!-- 5. DELIVERY (US to Bengaluru Drawing Route) -->
  <DeliverySection />

  <!-- 6. WHY APT (Horizontal Pinned Scroll + Flexibility Tabs) -->
  <WhyAptSection />

  <!-- 7. ABOUT (Scroll-Linked Text Fill Reveal + 4 Expandable Cards) -->
  <AboutSection />

  <!-- 8. CAREERS (Role Cards + Verified No Openings States) -->
  <CareersSection />

  <!-- 9. CONTACT (Oversized CTA + Interactive Form + Direct Details) -->
  <ContactSection />
</Base>
