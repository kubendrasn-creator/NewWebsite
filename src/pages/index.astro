---
// src/pages/index.astro
// Home Order: Hero; Modernization Spotlight; Apt/Agile/Assured; Scene B (4 beats);
// Services Bento; SDLC Stepper; Engagement Plans + Fit Finder; Statement + Values; CTA Band.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ModernizationSpotlight from '../components/ModernizationSpotlight.astro';
import PillarsScrollStory from '../components/PillarsScrollStory.astro';
import MotionScrollStory from '../components/MotionScrollStory.astro';
import ServicesBento from '../components/ServicesBento.astro';
import SdlcStepper from '../components/SdlcStepper.astro';
import EngagementFitSection from '../components/EngagementFitSection.astro';
import StatementValuesSection from '../components/StatementValuesSection.astro';
import CTABand from '../components/CTABand.astro';
---

<Base
  title="Apt Infosoft – Engineering Software Built to Last"
  description="Our Vision is to help small and mid-sized enterprises reap the benefits of modern technology and globalization."
>
  <!-- 1. Hero with Scene A 8s Pure SVG Loop -->
  <Hero />

  <!-- 2. Modernization Spotlight (Before/After Comparison) -->
  <ModernizationSpotlight />

  <!-- 3. Apt / Agile / Assured -->
  <PillarsScrollStory />

  <!-- 4. Scene B Scroll Story (4 Beats) -->
  <MotionScrollStory />

  <!-- 5. Services Bento -->
  <ServicesBento />

  <!-- 6. SDLC Stepper -->
  <SdlcStepper />

  <!-- 7. Engagement Plans + Fit Finder -->
  <EngagementFitSection />

  <!-- 8. Statement + Values -->
  <StatementValuesSection />

  <!-- 9. Action CTA Band -->
  <CTABand />
</Base>
