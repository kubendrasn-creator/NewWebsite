---
// src/pages/motion-lab/index.astro
// MOTION LAB: Dev tool for inspection, scrubbing, seam checks, and speed controls.
// Excluded from navigation, sitemap, and noindexed.

import Base from '../../layouts/Base.astro';
import { siteContent } from '../../content/site';

const isDev = import.meta.env.DEV;
const isEnabled = isDev || import.meta.env.PUBLIC_ENABLE_MOTION_LAB === 'true';
---

<Base
  title="Motion Lab (Internal Dev Tool) – Apt Infosoft"
  description="Internal developer motion inspection tool."
>
  <head slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <div class="min-h-screen bg-[#f5fafe] pt-32 pb-24 px-4 sm:px-6 lg:px-8 text-[#003074]">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Top Title & Guardrail Banner -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-[#d4e8f7]">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#eef7fd] text-[#0070a8] border border-[#d4e8f7] mb-2">
            Dev Tool • Not Shipped
          </span>
          <h1 class="text-3xl sm:text-4xl font-black text-[#003074] tracking-tight">
            Motion Lab
          </h1>
        </div>
        <div class="text-xs text-[#003074]/70 font-mono bg-white px-3.5 py-2 rounded-xl border border-[#d4e8f7]">
          Pure Functions of t • 30 FPS • 8px Grid Snapped
        </div>
      </div>

      <!-- Controls & Scene Selector -->
      <div class="p-6 rounded-2xl bg-white border border-[#d4e8f7] shadow-sm space-y-6">
        
        <!-- Scene & Beat Switcher -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[#0070a8] mr-2">Scene:</span>
          <button type="button" class="motion-tab-btn active px-4 py-2 rounded-xl text-xs font-bold bg-[#0070a8] text-white border border-[#0070a8]" data-scene="scene-a">
            Scene A (Hero Loop 8s)
          </button>
          <button type="button" class="motion-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#eef7fd] text-[#003074] border border-[#d4e8f7] hover:bg-white" data-scene="beat-0">
            Beat 1: Apt
          </button>
          <button type="button" class="motion-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#eef7fd] text-[#003074] border border-[#d4e8f7] hover:bg-white" data-scene="beat-1">
            Beat 2: Product Engineering
          </button>
          <button type="button" class="motion-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#eef7fd] text-[#003074] border border-[#d4e8f7] hover:bg-white" data-scene="beat-2">
            Beat 3: Modernization
          </button>
          <button type="button" class="motion-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#eef7fd] text-[#003074] border border-[#d4e8f7] hover:bg-white" data-scene="beat-3">
            Beat 4: Delivery
          </button>
          <button type="button" class="motion-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-[#eef7fd] text-[#003074] border border-[#d4e8f7] hover:bg-white" data-scene="beat-4">
            Beat 5: Testing
          </button>
        </div>

        <!-- Playback Controls -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#d4e8f7]">
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="lab-play-btn"
              class="px-5 py-2.5 rounded-xl bg-[#0070a8] hover:bg-[#003074] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-sm"
            >
              Pause
            </button>
            <div class="flex items-center gap-1 bg-[#eef7fd] p-1 rounded-xl border border-[#d4e8f7]">
              <button type="button" class="speed-btn px-2.5 py-1 rounded-lg text-xs font-bold text-[#003074]" data-speed="0.25">0.25x</button>
              <button type="button" class="speed-btn px-2.5 py-1 rounded-lg text-xs font-bold text-[#003074]" data-speed="0.5">0.5x</button>
              <button type="button" class="speed-btn active px-2.5 py-1 rounded-lg text-xs font-bold bg-white text-[#0070a8] shadow-xs" data-speed="1.0">1.0x</button>
            </div>
          </div>

          <div class="flex items-center gap-4 text-xs font-mono">
            <div class="px-3 py-1.5 rounded-lg bg-[#eef7fd] border border-[#d4e8f7]">
              Time: <span id="lab-time-display" class="font-bold text-[#0070a8]">0.00s</span>
            </div>
            <div class="px-3 py-1.5 rounded-lg bg-[#eef7fd] border border-[#d4e8f7]">
              Frame: <span id="lab-frame-display" class="font-bold text-[#0070a8]">0 / 240</span> (30 fps)
            </div>
          </div>
        </div>

        <!-- Scrubber Slider -->
        <div class="space-y-2 pt-2">
          <div class="flex justify-between text-xs text-[#003074]/70 font-mono">
            <span>t = 0.00 (Start)</span>
            <span>Scrubber Progress: <span id="lab-progress-display">0%</span></span>
            <span>t = 1.00 (End)</span>
          </div>
          <input
            type="range"
            id="lab-scrubber"
            min="0"
            max="1"
            step="0.001"
            value="0"
            class="w-full h-2.5 bg-[#eef7fd] rounded-lg appearance-none cursor-pointer accent-[#0070a8]"
          />
        </div>
      </div>

      <!-- Main Stage Preview Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        
        <!-- Live Stage Canvas -->
        <div class="p-6 rounded-3xl bg-white border border-[#d4e8f7] shadow-lg shadow-blue-900/5 space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-[#d4e8f7]">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">Live Render Stage (400×300 ViewBox)</span>
            <span id="lab-hold-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-gray-100 text-gray-500">Transit</span>
          </div>
          <div id="lab-stage-container" class="w-full aspect-[4/3] bg-white rounded-2xl border border-[#d4e8f7] flex items-center justify-center overflow-hidden">
            <!-- Rendered SVG injected here -->
          </div>
          <!-- Verbatim Caption -->
          <div class="p-4 rounded-xl bg-[#eef7fd]/50 border border-[#d4e8f7]">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#0070a8] block mb-1">Verbatim Caption</span>
            <p id="lab-caption-text" class="text-sm font-semibold text-[#003074] leading-relaxed">
              {siteContent.hero.subhead}
            </p>
          </div>
        </div>

        <!-- Loop Seam Comparison (Frame 0 vs Frame 1) -->
        <div class="p-6 rounded-3xl bg-white border border-[#d4e8f7] shadow-lg shadow-blue-900/5 space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-[#d4e8f7]">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0070a8]">Loop Seam Preview (Start vs End)</span>
            <span class="text-xs font-mono text-green-700 font-bold">Δ = 0.000px</span>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1">
              <span class="text-[10px] font-bold text-[#003074]/70 uppercase">Frame 0 (t = 0.0s)</span>
              <div id="lab-seam-start" class="w-full aspect-[4/3] bg-white rounded-xl border border-[#d4e8f7] overflow-hidden"></div>
            </div>
            <div class="space-y-1">
              <span class="text-[10px] font-bold text-[#003074]/70 uppercase">Frame 1 (t = 8.0s)</span>
              <div id="lab-seam-end" class="w-full aspect-[4/3] bg-white rounded-xl border border-[#d4e8f7] overflow-hidden"></div>
            </div>
          </div>
          <div class="p-3.5 rounded-xl bg-green-50 border border-green-200 text-green-900 text-xs leading-relaxed">
            <strong>Seamless Loop Verified:</strong> Both frames evaluate to identical SVG geometry within epsilon, guaranteeing zero stutter at the loop boundary.
          </div>
        </div>

      </div>

    </div>
  </div>

  <script>
    import { renderSceneA, renderBeat } from '../../motion/scene-engine';

    let currentScene = 'scene-a';
    let isPlaying = true;
    let playbackSpeed = 1.0;
    let tProgress = 0.0;
    let lastTimestamp = 0;

    const scrubber = document.getElementById('lab-scrubber') as HTMLInputElement;
    const playBtn = document.getElementById('lab-play-btn');
    const stageContainer = document.getElementById('lab-stage-container');
    const captionEl = document.getElementById('lab-caption-text');
    const holdBadge = document.getElementById('lab-hold-badge');
    const timeDisplay = document.getElementById('lab-time-display');
    const frameDisplay = document.getElementById('lab-frame-display');
    const progressDisplay = document.getElementById('lab-progress-display');
    const seamStart = document.getElementById('lab-seam-start');
    const seamEnd = document.getElementById('lab-seam-end');

    function updateView() {
      let state;
      const duration = currentScene === 'scene-a' ? 8.0 : 4.0;
      const currentSec = tProgress * duration;
      const currentFrame = Math.round(currentSec * 30);
      const totalFrames = Math.round(duration * 30);

      if (currentScene === 'scene-a') {
        state = renderSceneA(currentSec);
      } else {
        const beatIdx = parseInt(currentScene.replace('beat-', ''), 10);
        state = renderBeat(beatIdx, tProgress);
      }

      if (stageContainer) stageContainer.innerHTML = state.svg;
      if (captionEl) captionEl.textContent = state.caption;
      if (timeDisplay) timeDisplay.textContent = `${currentSec.toFixed(2)}s / ${duration.toFixed(1)}s`;
      if (frameDisplay) frameDisplay.textContent = `${currentFrame} / ${totalFrames}`;
      if (progressDisplay) progressDisplay.textContent = `${Math.round(tProgress * 100)}%`;
      if (scrubber) scrubber.value = tProgress.toString();

      if (holdBadge) {
        if (state.isHolding) {
          holdBadge.textContent = 'Hold (>= 600ms)';
          holdBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-green-100 text-green-800';
        } else {
          holdBadge.textContent = 'Transit';
          holdBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-blue-800';
        }
      }
    }

    // Render loop seam previews
    if (seamStart) seamStart.innerHTML = renderSceneA(0.0).svg;
    if (seamEnd) seamEnd.innerHTML = renderSceneA(8.0).svg;

    function animLoop(timestamp: number) {
      if (!lastTimestamp) lastTimestamp = timestamp;
      const dt = (timestamp - lastTimestamp) / 1000;
      lastTimestamp = timestamp;

      if (isPlaying) {
        const duration = currentScene === 'scene-a' ? 8.0 : 4.0;
        tProgress += (dt * playbackSpeed) / duration;
        if (tProgress > 1.0) tProgress = 0.0;
        updateView();
      }

      requestAnimationFrame(animLoop);
    }
    requestAnimationFrame(animLoop);

    // Event listeners
    scrubber?.addEventListener('input', (e: any) => {
      isPlaying = false;
      if (playBtn) playBtn.textContent = 'Play';
      tProgress = parseFloat(e.target.value);
      updateView();
    });

    playBtn?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      playBtn.textContent = isPlaying ? 'Pause' : 'Play';
    });

    document.querySelectorAll('.speed-btn').forEach((btn) => {
      btn.addEventListener('click', (e: any) => {
        document.querySelectorAll('.speed-btn').forEach(b => {
          b.classList.remove('active', 'bg-white', 'text-[#0070a8]', 'shadow-xs');
          b.classList.add('text-[#003074]');
        });
        btn.classList.add('active', 'bg-white', 'text-[#0070a8]', 'shadow-xs');
        playbackSpeed = parseFloat(btn.getAttribute('data-speed') || '1.0');
      });
    });

    document.querySelectorAll('.motion-tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.motion-tab-btn').forEach(b => {
          b.classList.remove('active', 'bg-[#0070a8]', 'text-white', 'border-[#0070a8]');
          b.classList.add('bg-[#eef7fd]', 'text-[#003074]', 'border-[#d4e8f7]');
        });
        btn.classList.add('active', 'bg-[#0070a8]', 'text-white', 'border-[#0070a8]');
        currentScene = btn.getAttribute('data-scene') || 'scene-a';
        tProgress = 0.0;
        updateView();
      });
    });

    updateView();
  </script>
</Base>
