---
// src/pages/404.astro
import Base from '../layouts/Base.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "404 Not Found",
      "item": "https://aptinfosoft.com/404.html"
    }
  ]
};
---

<Base
  title="404 – Page Not Found – Apt Infosoft"
  description="The requested page could not be located on Apt Infosoft."
  jsonLd={breadcrumbSchema}
>
  <section class="min-h-[70vh] flex items-center justify-center py-20 bg-gradient-to-b from-navy-950 via-navy-900 to-[#0b1120] text-white text-center relative overflow-hidden">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Big Accent 404 Code -->
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-teal-950/80 border border-teal-500/30 text-teal-400 font-black text-4xl mb-6 shadow-xl">
        404
      </div>

      <h1 class="text-3xl sm:text-4xl font-black tracking-tight mb-4 text-white">
        Page Not Found
      </h1>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
        The link you followed may be outdated, or the URL may have been migrated. Please navigate using the links below or reach out to our team.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-teal-600 hover:bg-teal-500 shadow transition-colors focus-visible:outline-2 focus-visible:outline-teal-400"
        >
          Return to Home
        </a>
        <a
          href="/services/"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-semibold text-slate-200 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors focus-visible:outline-2 focus-visible:outline-teal-400"
        >
          Explore Services
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-semibold text-slate-200 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors focus-visible:outline-2 focus-visible:outline-teal-400"
        >
          Contact Us
        </a>
      </div>

    </div>
  </section>
</Base>
