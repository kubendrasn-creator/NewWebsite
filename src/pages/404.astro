---
// src/pages/404.astro
import Base from '../layouts/Base.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="404 – Page Not Found – Apt Infosoft"
  description="The requested page could not be located on Apt Infosoft."
>
  <section class="min-h-[70vh] flex items-center justify-center py-24 bg-[#eef7fd] text-center relative overflow-hidden">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-white border border-[#d4e8f7] text-[#0070a8] font-black text-4xl shadow-sm">
        404
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-[#003074]">
        Page Not Found
      </h1>

      <p class="text-sm sm:text-base text-[#003074]/80 leading-relaxed max-w-md mx-auto">
        The requested resource has been relocated or is currently unavailable.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a
          href={`${baseUrl}/`}
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-white bg-[#0070a8] hover:bg-[#003074] shadow-md shadow-blue-900/10 transition-colors"
        >
          Return to Home
        </a>
      </div>

    </div>
  </section>
</Base>
