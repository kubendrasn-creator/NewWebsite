---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
---

<Base
  title="404 – Page Not Found | Apt Infosoft"
  description="The requested resource could not be found on Apt Infosoft."
>
  <section class="scene-full relative overflow-hidden bg-white text-center">
    <!-- Background brand tint grid -->
    <div class="absolute inset-0 bg-[#eef7fd]/30 pointer-events-none"></div>

    <div class="w-full max-w-xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 flex flex-col items-center justify-center space-y-8">
      
      <!-- 404 Badge with Swoosh Mark -->
      <div class="relative w-28 h-28 rounded-3xl bg-white border-2 border-[#d4e8f7] shadow-xl shadow-blue-900/5 flex items-center justify-center">
        <span class="text-4xl font-black text-[#0070a8] tracking-tighter">404</span>
        <span class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-[#0088cc] animate-ping opacity-75"></span>
      </div>

      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#eef7fd] text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7]">
          <span>Route Not Found</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-[#003074]">
          Page Not Located
        </h1>
        <p class="text-base sm:text-lg text-[#003074]/80 leading-relaxed max-w-md mx-auto">
          The requested page does not exist or may have been relocated during our architectural upgrade.
        </p>
      </div>

      <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
        <a
          href={url('/')}
          class="inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold text-white bg-[#0070a8] hover:bg-[#003074] shadow-lg shadow-blue-900/15 transition-all duration-200 magnetic-btn cursor-pointer"
        >
          Return to Home
        </a>
        <a
          href={url('/services/')}
          class="inline-flex items-center justify-center px-8 py-4 rounded-2xl text-base font-bold text-[#003074] bg-[#eef7fd] hover:bg-[#d4e8f7] border border-[#d4e8f7] transition-all duration-200 cursor-pointer"
        >
          View Services
        </a>
      </div>

    </div>
  </section>
</Base>
