---
// src/pages/services/[slug].astro
// Designed scene page for each practice area with full-viewport hero,
// bespoke animated illustration, animated list items from CONTENT.md,
// morphing Next Service panel, and Contact CTA.
import Base from '../../layouts/Base.astro';
import { siteContent, type ServiceDetail } from '../../content/site';
import { url } from '../../utils/url';
import ServiceEngineering from '../../components/illustrations/ServiceEngineering.astro';
import ServiceCustomApp from '../../components/illustrations/ServiceCustomApp.astro';
import ServiceSaaS from '../../components/illustrations/ServiceSaaS.astro';
import ServiceModernization from '../../components/illustrations/ServiceModernization.astro';
import ServiceTesting from '../../components/illustrations/ServiceTesting.astro';
import ServiceAnalytics from '../../components/illustrations/ServiceAnalytics.astro';
import CTABand from '../../components/CTABand.astro';

export function getStaticPaths() {
  const services = siteContent.services;
  return services.map((svc, idx) => ({
    params: { slug: svc.slug },
    props: {
      service: svc,
      currentIndex: idx,
      totalServices: services.length,
      nextService: services[(idx + 1) % services.length],
      prevService: services[(idx - 1 + services.length) % services.length],
    },
  }));
}

interface Props {
  service: ServiceDetail;
  currentIndex: number;
  totalServices: number;
  nextService: ServiceDetail;
  prevService: ServiceDetail;
}

const { service, currentIndex, totalServices, nextService, prevService } = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteContent.meta.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": `${siteContent.meta.url}services/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.title,
      "item": `${siteContent.meta.url}services/${service.slug}/`
    }
  ]
};
---

<Base
  title={`${service.title} – Apt Infosoft`}
  description={service.summary}
  jsonLd={breadcrumbSchema}
>
  <!-- Full-Viewport Hero Scene (min-h-[100svh], centered, offset by --header-h) -->
  <section class="scene-full bg-white relative border-b border-[#d4e8f7] overflow-hidden">
    
    <!-- Slanted decorative background ice band -->
    <div class="absolute inset-x-0 top-0 h-[40svh] bg-[#eef7fd] -skew-y-2 origin-top-left -z-10 pointer-events-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12">
      
      <!-- Breadcrumb Nav -->
      <nav aria-label="Breadcrumbs" class="mb-8">
        <ol class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#0070a8]">
          <li>
            <a href={url('/')} class="hover:underline">Home</a>
          </li>
          <li aria-hidden="true">•</li>
          <li>
            <a href={url('/services')} class="hover:underline">Services</a>
          </li>
          <li aria-hidden="true">•</li>
          <li class="text-[#003074]" aria-current="page">{service.shortTitle}</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Typography & Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#eef7fd] text-[#0070a8] text-xs font-bold uppercase tracking-wider border border-[#d4e8f7]">
            <span>Practice Area {service.number} of {totalServices}</span>
          </div>

          <h1 class="hero-headline text-[#003074] leading-[0.98]">
            {service.title}
          </h1>

          <p class="text-base sm:text-xl font-bold text-[#0070a8]">
            {service.tagline}
          </p>

          <p class="text-base sm:text-lg text-[#003074]/90 leading-relaxed font-normal">
            {service.summary}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href={url('/contact')}
              data-astro-prefetch="hover"
              class="magnetic-btn inline-flex items-center justify-center px-8 py-3.5 rounded-xl text-sm sm:text-base font-bold text-white bg-[#0070a8] hover:bg-[#003074] shadow-lg shadow-blue-900/15 transition-all duration-200"
            >
              <span>Inquire About {service.shortTitle}</span>
              <span class="ml-2" aria-hidden="true">→</span>
            </a>

            <a
              href={url('/services')}
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-[#003074] bg-[#eef7fd] hover:bg-[#d4e8f7] transition-colors"
            >
              <span>All Practice Areas</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Large Bespoke Illustration Scene (5 cols) -->
        <div
          class="lg:col-span-5 aspect-[4/3] rounded-3xl bg-[#eef7fd] border-2 border-[#d4e8f7] shadow-xl p-8 flex items-center justify-center relative overflow-hidden"
          style={{ viewTransitionName: `service-card-${service.slug}` }}
        >
          <div class="w-full h-full max-h-[300px] flex items-center justify-center">
            {service.slug === 'product-engineering' && <ServiceEngineering />}
            {service.slug === 'application-development' && <ServiceCustomApp />}
            {service.slug === 'saas' && <ServiceSaaS />}
            {service.slug === 'application-modernization' && <ServiceModernization />}
            {service.slug === 'testing' && <ServiceTesting />}
            {service.slug === 'business-analytics' && <ServiceAnalytics />}
          </div>

          <!-- Bottom badge -->
          <div class="absolute bottom-4 right-4 px-3 py-1 rounded-lg bg-white/90 border border-[#d4e8f7] text-[11px] font-mono font-bold text-[#0070a8]">
            AREA {service.number}
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Deep Narrative & Animated Capability List -->
  <section class="py-20 sm:py-28 bg-[#f5fafe] border-b border-[#d4e8f7]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
          Scope &amp; Delivery Approach
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-[#003074]">
          Engineering Execution
        </h2>
        <p class="text-base sm:text-lg text-[#003074]/90 leading-relaxed font-normal">
          {service.fullDescription}
        </p>
      </div>

      <!-- Key Capabilities & Advantages List (from CONTENT.md) -->
      {service.bulletPoints && (
        <div class="p-8 sm:p-12 rounded-3xl bg-white border border-[#d4e8f7] shadow-sm space-y-6">
          <h3 class="text-lg sm:text-xl font-bold text-[#003074] flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-[#0088cc]" />
            <span>Key Capabilities &amp; Advantages</span>
          </h3>

          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {service.bulletPoints.map((item, idx) => (
              <li class="reveal-up flex items-start gap-3 p-4 rounded-xl bg-[#eef7fd]/60 border border-[#d4e8f7]">
                <span class="w-6 h-6 rounded-lg bg-[#0070a8] text-white text-xs font-black flex items-center justify-center shrink-0 mt-0.5">
                  0{idx + 1}
                </span>
                <span class="text-sm sm:text-base font-semibold text-[#003074] leading-relaxed">
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
  </section>

  <!-- "Next Service" Morphing Panel (View Transition to next page hero) -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#d4e8f7]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex items-center justify-between mb-6">
        <span class="text-xs font-black uppercase tracking-widest text-[#0070a8]">
          Continue Exploration
        </span>
        <span class="text-xs font-mono font-bold text-[#0088cc]">
          NEXT UP: {nextService.number} / {totalServices}
        </span>
      </div>

      <!-- Morphing Next Service Card -->
      <a
        href={url(`/services/${nextService.slug}`)}
        data-astro-prefetch="hover"
        data-cursor="view"
        style={{ viewTransitionName: `service-card-${nextService.slug}` }}
        class="bento-conic-border group block p-8 sm:p-12 rounded-3xl bg-[#f5fafe] border-2 border-[#d4e8f7] shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1"
      >
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-2">
            <span class="text-xs font-mono font-bold text-[#0088cc] uppercase">
              Practice Area {nextService.number}
            </span>
            <h3 class="text-2xl sm:text-4xl font-black text-[#003074] group-hover:text-[#0088cc] transition-colors">
              {nextService.title}
            </h3>
            <p class="text-sm sm:text-base text-[#003074]/80 max-w-xl">
              {nextService.tagline}
            </p>
          </div>

          <div class="inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-[#0070a8] text-white text-sm font-bold group-hover:bg-[#003074] transition-colors shrink-0">
            <span>Explore Next Capability</span>
            <span class="transform group-hover:translate-x-1.5 transition-transform duration-200" aria-hidden="true">
              →
            </span>
          </div>
        </div>
      </a>

    </div>
  </section>

  <!-- Contact CTA Band -->
  <CTABand />
</Base>

