---
// src/pages/services/[id].astro
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import ServiceAnimation from '../../components/ServiceAnimation.astro';
import CTABand from '../../components/CTABand.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { id: service.data.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { title, text, icon, items, advantages } = service.data;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://aptinfosoft.com/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": `https://aptinfosoft.com/services/${service.data.id}/`
    }
  ]
};
---

<Base
  title={`${title} – Apt Infosoft`}
  description={text.slice(0, 155)}
  jsonLd={breadcrumbSchema}
>
  <!-- Service Hero -->
  <section class="py-20 lg:py-28 bg-[#f6f9fc] border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Enlarged Micro-Animation -->
      <div class="mx-auto mb-8 p-6 rounded-3xl bg-white border border-slate-200 shadow-sm w-fit">
        <ServiceAnimation icon={icon} enlarged={true} />
      </div>

      <h1
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-[#033275] tracking-tight mb-6"
        transition:name={`service-title-${service.data.id}`}
      >
        {title}
      </h1>

      <p class="text-base sm:text-xl text-slate-700 leading-relaxed font-normal max-w-3xl mx-auto">
        {text}
      </p>

    </div>
  </section>

  <!-- Details / Items / Advantages Section (if present) -->
  {(items.length > 0 || advantages.length > 0) && (
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        
        {items.length > 0 && (
          <div class="p-8 sm:p-10 rounded-3xl bg-[#f6f9fc] border border-slate-200 shadow-sm">
            <ul class="space-y-4">
              {items.map((item) => (
                <li class="flex items-center gap-3 text-base sm:text-lg text-slate-800 font-medium">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#0073df] shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {advantages.length > 0 && (
          <div class="space-y-4">
            {advantages.map((adv) => (
              <div class="p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 shadow-sm">
                <p class="text-base text-slate-700 leading-relaxed">
                  {adv}
                </p>
              </div>
            ))}
          </div>
        )}

      </div>
    </section>
  )}

  <CTABand />
</Base>
