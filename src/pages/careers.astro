---
// src/pages/careers.astro
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import CTABand from '../components/CTABand.astro';

const careerRoles = await getCollection('careers');
const sortedCareers = careerRoles.sort((a, b) => a.data.order - b.data.order);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Career",
      "item": "https://aptinfosoft.com/careers/"
    }
  ]
};
---

<Base
  title="Career – Apt Infosoft"
  description="Career opportunities and role openings at Apt Infosoft."
  jsonLd={breadcrumbSchema}
>
  <section class="py-20 lg:py-28 bg-[#f6f9fc] border-b border-slate-200 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-[#033275] text-xs font-bold uppercase tracking-wider mb-4">
        <span>Join Our Team</span>
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#033275] tracking-tight mb-6">
        Career
      </h1>
    </div>
  </section>

  <!-- Roles Grid -->
  <section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedCareers.map((role) => (
          <div class="p-8 sm:p-10 rounded-3xl bg-[#f6f9fc] border border-slate-200 shadow-sm flex flex-col justify-between space-y-6">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[#005bb5] block mb-2">
                Engineering
              </span>
              <h2 class="text-2xl font-bold text-[#033275]">
                {role.data.title}
              </h2>
            </div>

            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-200/70 text-slate-700 text-xs sm:text-sm font-semibold w-fit">
              <span class="w-2 h-2 rounded-full bg-slate-500"></span>
              <span>{role.data.status}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</Base>
