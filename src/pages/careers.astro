---
// src/pages/careers.astro
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABanner from '../components/CTABanner.astro';

const allRoles = await getCollection('careers');
const openRoles = allRoles.filter((r) => r.data.open !== false);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aptinfosoft.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Careers",
      "item": "https://aptinfosoft.com/careers/"
    }
  ]
};

const culturePoints = [
  {
    title: 'Engineers Lead Engineering',
    desc: 'You work alongside architects and technical founders who write code, understand trade-offs, and respect thoughtful engineering solutions.',
  },
  {
    title: 'High Trust & Autonomy',
    desc: 'We judge work by code quality, system reliability, and business impact — never by surveillance metrics or micromanagement.',
  },
  {
    title: 'Modern Technology Stacks',
    desc: 'We build with TypeScript, modern cloud architectures, automated CI/CD pipelines, and clean tooling across all client and internal projects.',
  },
  {
    title: 'Continuous Professional Growth',
    desc: 'Mentorship, sponsored certifications, and exposure to challenging multi-tenant architectures and high-scale systems.',
  },
];
---

<Base
  title="Careers at Apt Infosoft – Join Our Software Engineering Team"
  description="Explore software engineering, QA automation, and cloud infrastructure opportunities at Apt Infosoft. Build software that fits, built to last."
  jsonLd={breadcrumbSchema}
>
  <!-- Careers Hero -->
  <section class="py-20 lg:py-28 bg-gradient-to-b from-navy-950 via-navy-900 to-[#0b1120] text-white text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-teal-400 mb-4">
        Join Apt Infosoft
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-6">
        Build Software You Are Proud Of
      </h1>
      <p class="text-base sm:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Join a team of curious, pragmatic engineers solving real technical challenges for ambitious clients worldwide.
      </p>
    </div>
  </section>

  <!-- Culture & Engineering Philosophy -->
  <section class="py-20 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Our Work Culture"
        title="Why Engineers Join and Stay"
        subtitle="We have designed an engineering environment that prizes craft, clear communication, and mutual respect."
      />

      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {culturePoints.map((point) => (
          <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-teal-500/40 hover:shadow-md transition-all">
            <h3 class="text-lg font-bold text-navy-900 dark:text-white mb-2">
              {point.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {point.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Open Positions List -->
  <section class="py-20 bg-[var(--color-bg-secondary)] border-y border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Current Openings"
        title="Explore Open Positions"
        subtitle="We are actively hiring experienced engineers across full-stack development, QA automation, and cloud architecture."
      />

      <div class="mt-16 space-y-6">
        {openRoles.map((role) => (
          <div class="p-6 sm:p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] hover:border-teal-500/50 hover:shadow-lg transition-all duration-200">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
              
              <!-- Role Details -->
              <div class="space-y-3">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                    {role.data.department}
                  </span>
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                    {role.data.type}
                  </span>
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                    {role.data.location}
                  </span>
                </div>

                <h3 class="text-2xl font-bold text-navy-900 dark:text-white">
                  {role.data.title}
                </h3>

                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl">
                  {role.data.summary}
                </p>
              </div>

              <!-- Apply Action Button -->
              <div class="shrink-0">
                <a
                  href={`/contact/?role=${encodeURIComponent(role.data.title)}`}
                  class="inline-flex items-center justify-center w-full md:w-auto px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-teal-600 hover:bg-teal-500 shadow transition-colors focus-visible:outline-2 focus-visible:outline-teal-500"
                >
                  Apply for this Role
                </a>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Speculative Application Note -->
      <div class="mt-12 p-8 rounded-2xl border border-dashed border-[var(--color-border)] bg-[var(--color-card-bg)] text-center space-y-4">
        <h3 class="text-xl font-bold text-navy-900 dark:text-white">
          Do not see your exact discipline?
        </h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm max-w-xl mx-auto leading-relaxed">
          We are always excited to connect with talented engineers, system architects, and technical project leads. Send us an open application.
        </p>
        <a
          href="/contact/?role=Speculative%20Application"
          class="inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-semibold text-teal-600 dark:text-teal-400 bg-teal-50 dark:bg-teal-950/40 hover:bg-teal-100 dark:hover:bg-teal-900/50 border border-teal-200 dark:border-teal-800 transition-colors"
        >
          Submit General Application
        </a>
      </div>

    </div>
  </section>

  <CTABanner
    eyebrow="Questions?"
    title="Curious about what it is like to engineer at Apt Infosoft?"
    subtitle="Reach out directly to our hiring team to learn about our delivery pods and onboarding roadmap."
    primaryCtaText="Contact Recruiting"
    primaryCtaHref="/contact/?service=Career%20Application"
  />
</Base>
